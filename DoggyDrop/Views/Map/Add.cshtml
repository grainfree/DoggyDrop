@model DoggyDrop.ViewModels.TrashBinViewModel
@{
    ViewData["Title"] = "Dodaj kos";
}

@section Styles {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
          integrity="sha256-p4NxAoJBhIINfQXh6ULpR5txR9wra5I3BcVsTPY1p3A="
          crossorigin="" />
}

<section class="app-page add-bin-page">
    <header class="app-page__header add-bin-hero">
        <div>
            <h1 class="app-page__title">Dodaj kos</h1>
            <p class="app-page__lead">Oznaci lokacijo, dodaj fotografijo in pomagaj drugim lastnikom psov.</p>
        </div>
    </header>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }

    <form asp-action="Add" method="post" enctype="multipart/form-data" class="add-bin-form">
        <div asp-validation-summary="All" class="text-danger small mb-3"></div>

        <article class="add-bin-panel add-bin-location-panel">
            <div class="add-bin-panel__header">
                <div>
                    <h2>Lokacija</h2>
                    <p id="locationStatus" hidden></p>
                </div>
                <button type="button" id="useMyLocation" class="add-bin-locate-button" aria-label="Uporabi mojo lokacijo">
                    <i class="bi bi-crosshair" aria-hidden="true"></i>
                </button>
            </div>

            <div id="map"></div>

            <div class="add-bin-coordinates">
                <span>Lat: <strong id="latText">-</strong></span>
                <span>Lng: <strong id="lngText">-</strong></span>
            </div>
        </article>

        <article class="add-bin-panel add-bin-details-panel">
            <h2>Podatki o lokaciji</h2>
            <div class="add-bin-fields">
                <div class="add-bin-name-field">
                    <label asp-for="Name" class="form-label">Ime lokacije</label>
                    <input asp-for="Name" class="form-control" placeholder="Npr. park ob drevoredu" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>

                <div class="add-bin-photo-field">
                    <label asp-for="ImageFile" class="form-label">Fotografija kosa</label>
                    <input asp-for="ImageFile" id="ImageFile" type="file" accept="image/*" capture="environment" class="form-control" />
                    <span asp-validation-for="ImageFile" class="text-danger small"></span>
                    <img id="preview" src="#" class="add-bin-preview" alt="Predogled fotografije" hidden />
                </div>
            </div>
        </article>

        <input type="hidden" asp-for="Latitude" id="Latitude" />
        <input type="hidden" asp-for="Longitude" id="Longitude" />

        <div class="add-bin-actions">
            <a class="btn btn-outline-secondary rounded-pill" asp-controller="Map" asp-action="Index">Preklici</a>
            <button type="submit" class="btn btn-success rounded-pill fw-semibold">Shrani kos</button>
        </div>

        <div id="loading" class="add-bin-loading" hidden>
            <div class="spinner-border text-success" role="status">
                <span class="visually-hidden">Nalagam...</span>
            </div>
            <p>Kos se shranjuje...</p>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
            integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
            crossorigin=""></script>

    <script>
        let map;
        let marker;
        const selectedLocationIcon = L.divIcon({
            className: "",
            html: `<span class="add-bin-location-marker"><i class="bi bi-trash3-fill" aria-hidden="true"></i></span>`,
            iconSize: [42, 48],
            iconAnchor: [21, 46]
        });

        document.addEventListener("DOMContentLoaded", function () {
            initMap();
            initImagePreview();
            initLoadingState();
            document.getElementById("useMyLocation").addEventListener("click", () => useCurrentLocation(false));
            useCurrentLocation(true);
            window.addEventListener("pageshow", refreshMapSize);
            window.addEventListener("resize", refreshMapSize);
            window.addEventListener("orientationchange", () => setTimeout(refreshMapSize, 250));
        });

        function initMap() {
            const fallbackLocation = [46.5547, 15.6459];
            map = L.map("map").setView(fallbackLocation, 15);

            L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
                maxZoom: 19,
                attribution: "&copy; OpenStreetMap"
            }).addTo(map);

            setSelectedLocation(fallbackLocation[0], fallbackLocation[1]);
            map.on("click", function (e) {
                setSelectedLocation(e.latlng.lat, e.latlng.lng);
            });

            requestAnimationFrame(() => map.invalidateSize());
            setTimeout(() => map.invalidateSize(), 300);
            setTimeout(() => map.invalidateSize(), 900);
        }

        function refreshMapSize() {
            if (map) {
                map.invalidateSize();
            }
        }

        function setLocationStatus(message) {
            const status = document.getElementById("locationStatus");
            status.textContent = message;
            status.hidden = !message;
        }

        function useCurrentLocation(isAutomatic = false) {
            if (!navigator.geolocation) {
                setLocationStatus("Ta brskalnik ne podpira lokacije. Lokacijo lahko oznacis na zemljevidu.");
                return;
            }

            if (!window.isSecureContext) {
                setLocationStatus("GPS na telefonu zahteva HTTPS. Lokacijo lahko oznacis na zemljevidu.");
                return;
            }

            if (!isAutomatic) {
                setLocationStatus("Iskanje tvoje lokacije...");
            }

            navigator.geolocation.getCurrentPosition(function (position) {
                const lat = position.coords.latitude;
                const lng = position.coords.longitude;
                map.setView([lat, lng], 17);
                setSelectedLocation(lat, lng);
                refreshMapSize();
                setLocationStatus("");
            }, function () {
                setLocationStatus("Lokacije ni bilo mogoce pridobiti. Lokacijo lahko oznacis na zemljevidu.");
            }, {
                enableHighAccuracy: true,
                maximumAge: 30000,
                timeout: 10000
            });
        }

        function setSelectedLocation(lat, lng) {
            const roundedLat = Number(lat).toFixed(6);
            const roundedLng = Number(lng).toFixed(6);

            document.getElementById("Latitude").value = roundedLat;
            document.getElementById("Longitude").value = roundedLng;
            document.getElementById("latText").textContent = roundedLat;
            document.getElementById("lngText").textContent = roundedLng;

            if (marker) {
                marker.setLatLng([lat, lng]);
            } else {
                marker = L.marker([lat, lng], { draggable: true, icon: selectedLocationIcon }).addTo(map);
                marker.on("dragend", function () {
                    const position = marker.getLatLng();
                    setSelectedLocation(position.lat, position.lng);
                });
            }
        }

        function initImagePreview() {
            const fileInput = document.getElementById("ImageFile");
            const preview = document.getElementById("preview");

            fileInput.addEventListener("change", function (e) {
                const [file] = e.target.files;
                if (file) {
                    preview.src = URL.createObjectURL(file);
                    preview.hidden = false;
                }
            });
        }

        function initLoadingState() {
            document.querySelector(".add-bin-form").addEventListener("submit", function () {
                document.getElementById("loading").hidden = false;
            });
        }
    </script>
}

<style>
    .leaflet-container {
        overflow: hidden;
        background: #ddd;
    }

    .leaflet-pane,
    .leaflet-tile,
    .leaflet-marker-icon,
    .leaflet-marker-shadow,
    .leaflet-tile-container,
    .leaflet-pane > svg,
    .leaflet-pane > canvas,
    .leaflet-zoom-box,
    .leaflet-image-layer,
    .leaflet-layer {
        position: absolute;
        left: 0;
        top: 0;
    }

    .leaflet-tile {
        width: 256px;
        height: 256px;
    }

    .add-bin-hero {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 16px;
    }

    .add-bin-form {
        display: grid;
        gap: 14px;
        max-width: 100%;
    }

    .add-bin-form > .text-danger:empty {
        display: none;
    }

    .add-bin-panel {
        min-width: 0;
        max-width: 100%;
        padding: 18px;
        border: 1px solid rgba(31, 45, 41, 0.1);
        border-radius: 14px;
        background: #ffffff;
        box-shadow: 0 12px 28px rgba(31, 45, 41, 0.08);
    }

    .add-bin-location-panel {
        display: grid;
        gap: 12px;
    }

    .add-bin-panel h2 {
        margin: 0 0 14px;
        font-size: 1.1rem;
        font-weight: 950;
    }

    .add-bin-panel__header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 12px;
    }

    .add-bin-panel__header h2 {
        margin-bottom: 4px;
    }

    .add-bin-panel__header p {
        margin: 0;
        color: #65716d;
    }

    .add-bin-locate-button {
        display: inline-grid;
        width: 44px;
        height: 44px;
        min-width: 44px;
        place-items: center;
        border: 1px solid rgba(47, 109, 95, 0.16);
        border-radius: 999px;
        background: #eff8f1;
        color: #2f6d5f;
        box-shadow: 0 10px 20px rgba(23, 50, 44, 0.1);
    }

    .add-bin-locate-button:focus,
    .add-bin-locate-button:hover {
        background: #dff2e5;
        color: #245c4f;
    }

    .add-bin-fields {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        gap: 14px;
    }

    .add-bin-preview {
        width: 100%;
        max-height: 220px;
        object-fit: cover;
        margin-top: 12px;
        border-radius: 14px;
    }

    #map {
        position: relative;
        z-index: 1;
        height: 400px;
        width: 100%;
        max-width: 100%;
        overflow: hidden;
        isolation: isolate;
        border-radius: 14px;
        background: #eef3ea;
    }

    .add-bin-location-marker {
        position: relative;
        display: grid;
        width: 42px;
        height: 42px;
        place-items: center;
        border: 3px solid #ffffff;
        border-radius: 16px 16px 16px 4px;
        background: linear-gradient(135deg, #2f6d5f, #55c4aa);
        color: #ffffff;
        font-size: 1.18rem;
        box-shadow: 0 12px 22px rgba(23, 50, 44, 0.28);
        transform: rotate(-45deg);
    }

    .add-bin-location-marker i {
        transform: rotate(45deg);
    }

    .add-bin-location-marker::after {
        content: "";
        position: absolute;
        right: -6px;
        bottom: -6px;
        width: 14px;
        height: 14px;
        border: 3px solid #ffffff;
        border-radius: 999px;
        background: #ffd56a;
    }

    .add-bin-coordinates {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        color: #65716d;
        font-size: 0.86rem;
        font-weight: 800;
    }

    .add-bin-coordinates strong {
        color: #1f2d29;
    }

    .add-bin-actions {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
    }

    .add-bin-actions .btn {
        min-width: 150px;
    }

    .add-bin-loading {
        display: grid;
        place-items: center;
        gap: 8px;
        padding: 18px;
        color: #65716d;
        font-weight: 800;
    }

    .add-bin-loading p {
        margin: 0;
    }

    @@media (max-width: 575.98px) {
        .add-bin-page {
            min-height: calc(100svh - 58px);
            overflow: visible;
            padding: 0 8px calc(92px + env(safe-area-inset-bottom));
        }

        .add-bin-hero {
            display: none;
        }

        .add-bin-form {
            display: flex;
            flex-direction: column;
            gap: 10px;
            min-height: 0;
            overflow: visible;
        }

        .add-bin-form > .text-danger {
            margin-bottom: 0 !important;
        }

        .add-bin-panel {
            padding: 10px;
            border-radius: 16px;
        }

        .add-bin-panel h2 {
            margin-bottom: 6px;
            font-size: 0.92rem;
        }

        .add-bin-panel__header {
            margin-bottom: 4px;
            min-height: 36px;
        }

        .add-bin-locate-button {
            width: 34px;
            height: 34px;
            min-width: 34px;
        }

        #map {
            height: clamp(245px, 38svh, 330px);
            min-height: 245px;
            width: 100%;
            border-radius: 14px;
        }

        .add-bin-location-panel {
            grid-template-rows: auto auto;
            gap: 8px;
        }

        .add-bin-coordinates {
            display: none;
        }

        .add-bin-details-panel {
            overflow: visible;
        }

        .add-bin-fields {
            grid-template-columns: 1fr;
            gap: 8px;
        }

        .add-bin-details-panel .form-label {
            margin-bottom: 3px;
            font-size: 0.78rem;
        }

        .add-bin-details-panel .form-control {
            min-height: 40px;
            padding: 8px 12px;
            border-radius: 12px;
            font-size: 0.9rem;
        }

        .add-bin-preview {
            max-height: 86px;
            margin-top: 6px;
            border-radius: 12px;
        }

        .add-bin-actions {
            position: sticky;
            bottom: calc(76px + env(safe-area-inset-bottom));
            z-index: 20;
            display: grid;
            grid-template-columns: 0.82fr 1.18fr;
            gap: 8px;
            padding: 8px 0 2px;
            background: linear-gradient(180deg, rgba(247, 250, 246, 0), rgba(247, 250, 246, 0.96) 28%, rgba(247, 250, 246, 0.96));
        }

        .add-bin-actions .btn {
            width: 100%;
            min-width: 0;
            min-height: 46px;
            padding: 10px 12px;
        }

        .add-bin-loading {
            position: fixed;
            inset: 0;
            z-index: 5000;
            background: rgba(255, 255, 255, 0.86);
        }
    }
</style>
