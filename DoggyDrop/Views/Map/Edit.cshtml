@model DoggyDrop.ViewModels.TrashBinEditViewModel
@inject DoggyDrop.Services.IBinPhotoStorage BinPhotos
@{
    ViewData["Title"] = "Uredi koš";
}

<style>
    .edit-form-container {
        max-width: 500px;
        margin: 0 auto;
        padding: 20px;
        background-color: #f5f5f5;
        border-radius: 12px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        margin-top: 20px;
    }

    .form-label {
        font-weight: 600;
    }

    .btn-submit {
        background-color: #425F57;
        color: white;
        border: none;
        border-radius: 8px;
        padding: 10px 20px;
        font-size: 16px;
        width: 100%;
    }

        .btn-submit:hover {
            background-color: #3b534d;
        }

    #preview {
        border-radius: 8px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
        margin-top: 10px;
        max-height: 200px;
    }

    .current-image {
        max-height: 200px;
        margin-bottom: 10px;
    }
    #bin-photo-rotation button { min-height: 44px; }
</style>

<div class="edit-form-container">
    <h2 class="text-center mb-4">✏️ Uredi koš</h2>
    @if (TempData["BinPhotoMessage"] is string photoMessage) { <p role="status">@photoMessage</p> }

    <form asp-action="Edit" enctype="multipart/form-data" method="post">
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="Snapshot" />

        <div class="mb-3">
            <label asp-for="Name" class="form-label">Ime lokacije</label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Latitude" class="form-label">Zemljepisna širina</label>
            <input asp-for="Latitude" class="form-control" />
            <span asp-validation-for="Latitude" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Longitude" class="form-label">Zemljepisna dolžina</label>
            <input asp-for="Longitude" class="form-control" />
            <span asp-validation-for="Longitude" class="text-danger"></span>
        </div>

        @if (!string.IsNullOrEmpty(Model.CurrentImageUrl))
        {
            <div class="mb-3 text-center">
                <label class="form-label d-block fw-semibold">📷 Trenutna slika</label>
                <img id="current-bin-photo" src="@Model.CurrentImageUrl" alt="Trenutna slika" class="img-fluid current-image" />
            </div>
        }

        <div class="mb-3 text-center">
            <label for="photoInput" class="form-label d-block fw-semibold mb-2">🔄 Zamenjaj sliko (neobvezno)</label>

            <label for="photoInput" class="btn btn-outline-primary w-100 py-3" style="border-radius: 12px;">
                📸 Klikni za izbiro nove slike
            </label>

            <input asp-for="ImageFile" id="photoInput" type="file" accept="image/jpeg,image/png,image/webp" class="d-none" />
            <img id="preview" src="#" class="img-fluid mt-2 d-none" alt="Predogled" />

            <div class="form-text mt-2">JPG, PNG ali WebP do 12 MiB. Če ne naložiš slike, bo obstoječa ostala.</div>
            <span asp-validation-for="ImageFile" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-submit">💾 Shrani spremembe</button>
    </form>
    @if (User.IsInRole("Admin"))
    {
        <section class="mt-3" aria-labelledby="bin-rotation-title">
            <h3 id="bin-rotation-title" class="h6">Obrni shranjeno fotografijo</h3>
            @if (BinPhotos.CanRotate(ViewData["BinPhotoUrl"] as string))
            {
                <p class="small">Zasuk takoj shrani trenutno fotografijo. Spremembe zgornjega obrazca shrani posebej.</p>
                <form id="bin-photo-rotation" asp-controller="AdminBinPhotos" asp-action="Rotate" method="post" class="d-flex flex-wrap gap-2">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <button class="btn btn-outline-secondary py-2" name="operation" value="left" title="Zavrti levo za 90°">Zavrti levo</button>
                    <button class="btn btn-outline-secondary py-2" name="operation" value="right" title="Zavrti desno za 90°">Zavrti desno</button>
                    <button class="btn btn-outline-secondary py-2" name="operation" value="half">Obrni za 180°</button>
                </form>
                <p id="bin-photo-unavailable" class="small" role="status" hidden>Fotografije ni mogoče prikazati. Naloži nadomestno fotografijo.</p>
            }
            else
            {
                <p class="small">Fotografija manjka ali ni podprta upravljana slika. Za zasuk naloži nadomestno fotografijo.</p>
            }
        </section>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        const storedPhoto = document.getElementById("current-bin-photo");
        function disableUnavailablePhoto() {
            document.querySelectorAll("#bin-photo-rotation button").forEach(button => button.disabled = true);
            const message = document.getElementById("bin-photo-unavailable");
            if (message) message.hidden = false;
        }
        if (storedPhoto) {
            storedPhoto.addEventListener("error", disableUnavailablePhoto);
            if (storedPhoto.complete && storedPhoto.naturalWidth === 0) disableUnavailablePhoto();
        }
        document.getElementById("photoInput").addEventListener("change", function (event) {
            const [file] = event.target.files;
            if (file) {
                const preview = document.getElementById("preview");
                preview.src = URL.createObjectURL(file);
                preview.classList.remove("d-none");
            }
        });
    </script>
}
