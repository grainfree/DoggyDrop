@model DoggyDrop.Services.PlaceImportPage
@{ ViewData["Title"] = "Uvoz zaključen"; }
@section Styles {
    <link rel="stylesheet" href="~/css/places.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/bin-import.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/place-import.css" asp-append-version="true" />
}
<main class="places-page bin-import place-import">
    <h1>Uvoženih @Model.Result!.Imported lokacij.</h1>
    <partial name="_Context" model="Model" />
    <p>Skupaj prebranih vrstic: @Model.Result.Total</p>
    <p>Preskočenih možnih dvojnikov: @Model.Result.Duplicates · Neveljavno: @Model.Result.Invalid · Neizbrane pripravljene vrstice: @Model.Result.Unselected</p>
    <a asp-controller="AdminPlaces" asp-action="Index" asp-route-sourceId="@Model.Source.Id" class="places-button">Preglej lokacije</a>
    <a asp-action="Index" class="places-button">Nov uvoz</a>
    <a asp-controller="Map" asp-action="Index" class="places-button">Odpri zemljevid</a>
    <form asp-action="Cancel" asp-route-id="@Model.Id" method="post"><button class="places-button" type="submit">Zapri rezultat in sprosti začasni prostor</button></form>
</main>
