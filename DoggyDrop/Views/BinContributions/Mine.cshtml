@model IReadOnlyList<DoggyDrop.Controllers.BinContributionHistory>
@using DoggyDrop.Services
@using DoggyDrop.Models
@{ ViewData["Title"] = "Moji prispevki"; }
@section Styles { <link rel="stylesheet" href="~/css/bin-contributions.css" asp-append-version="true" /> }
<main class="bin-contribution-page">
    <h1>Moji prispevki</h1>
    @if (TempData["ContributionMessage"] is string message) { <p role="status">@message</p> }
    <p><a asp-controller="Map" asp-action="MyBins">Moji predlogi novih košev</a> · <a href="/">Zemljevid</a></p>
    @foreach (var item in Model) {
        <article><h2>Koš #@item.BinId</h2><p>@(item.Type == BinContributionType.Photo ? "Fotografija" : BinCommunityRules.Reason(item.Reason)) · @BinCommunityRules.Status(item.Status)</p><time>@item.CreatedAt.ToString("dd.MM.yyyy")</time></article>
    }
    @if (Model.Count == 0) { <p>Prispevkov še ni.</p> }
    <nav aria-label="Strani prispevkov">
        @if (ViewBag.Page > 1) { <a asp-action="Mine" asp-route-page="@(ViewBag.Page - 1)">Prejšnja stran</a> }
        @if (ViewBag.HasNext) { <a asp-action="Mine" asp-route-page="@(ViewBag.Page + 1)">Naslednja stran</a> }
    </nav>
</main>
