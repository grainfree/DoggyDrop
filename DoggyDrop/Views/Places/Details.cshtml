@model DoggyDrop.ViewModels.PlaceDetailsViewModel
@using DoggyDrop.Models
@{ ViewData["Title"] = Model.Name; }
@section Styles {
    <partial name="_MapBasemapStyles" />
    <link rel="stylesheet" href="~/css/places.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/place-save.css" asp-append-version="true" />
}
<main class="places-page places-details">
    @if (TempData["SavedPlaceMessage"] is string message)
    {
        <p class="place-save-feedback" role="status">@message</p>
    }
    <a class="places-back" asp-controller="Map" asp-action="Index"><i class="bi bi-arrow-left" aria-hidden="true"></i> Zemljevid</a>
    @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
    {
        <div class="places-details__media">
            <img src="@Model.ImageUrl" alt="@Model.Name" loading="lazy" referrerpolicy="no-referrer" />
            <div class="places-details__media-fallback" role="img" aria-label="Fotografija ni na voljo" hidden>
                <i class="dd-place-icon @Model.IconClass" aria-hidden="true"></i>
                <span>Fotografija ni na voljo</span>
            </div>
        </div>
    }
    <header class="places-details__header">
        <span class="places-eyebrow">@Model.CategoryLabel</span>
        @if (!Model.IsCommercial)
        {
            <span class="places-details__destination places-details__destination--@Model.CategoryKey" aria-hidden="true"><i class="dd-place-icon @Model.IconClass"></i></span>
        }
        @if (!string.IsNullOrWhiteSpace(Model.LogoUrl))
        {
            <span class="places-details__logo" role="img" aria-label="@Model.Name – @Model.CategoryLabel"><i class="dd-place-icon @Model.IconClass" aria-hidden="true"></i><img class="managed-place-image" src="@Model.LogoUrl" alt="" loading="lazy" referrerpolicy="no-referrer" /></span>
        }
        <h1>@Model.Name</h1>
        @if (Model.IsCurrentlyFeatured) { <span class="place-featured-badge" title="Promocijska izpostavitev; ne pomeni priporočila DoggyDrop.">Izpostavljeno</span> }
        @if (!string.IsNullOrWhiteSpace(Model.Address)) { <p>@Model.Address</p> }
    </header>
    <div class="places-details__actions">
        <a class="places-button" asp-controller="Places" asp-action="Index">Razišči lokacije</a>
        <a class="places-button places-button--primary" asp-controller="Map" asp-action="Index" asp-route-placeId="@Model.Id" asp-route-navigate="1"><i class="bi bi-signpost-2" aria-hidden="true"></i> Navodila za pot</a>
        @if (Model.TelephoneHref != null) { <a class="places-button" href="@Model.TelephoneHref"><i class="bi bi-telephone" aria-hidden="true"></i> Pokliči</a> }
        @if (Model.WebsiteUrl != null) { <a class="places-button" href="@Model.WebsiteUrl" target="_blank" rel="noopener noreferrer"><i class="bi bi-box-arrow-up-right" aria-hidden="true"></i> Spletna stran</a> }
        <partial name="_PlaceSave" model="@(new DoggyDrop.ViewModels.PlaceSaveViewModel(Model.Id, Model.Name, Model.IsSaved, Url.Action("Details", "Places", new { id = Model.Id })!))" />
    </div>
    <div class="places-details__information">
        @if (Model.Amenities.Count > 0)
        {
            <section class="place-amenities" aria-labelledby="placeAmenitiesTitle">
                <h2 id="placeAmenitiesTitle">Za pse</h2>
                <ul>
                    @foreach (var amenity in Model.Amenities)
                    {
                        <li><i class="bi @amenity.IconClass" aria-hidden="true"></i><span>@amenity.Label</span></li>
                    }
                </ul>
            </section>
        }
        @if (!string.IsNullOrWhiteSpace(Model.OpeningHours)) { <section><h2>Delovni čas</h2><p>@Model.OpeningHours</p></section> }
        @if (!string.IsNullOrWhiteSpace(Model.Description)) { <section><h2>O lokaciji</h2><p>@Model.Description</p></section> }
        @if (!string.IsNullOrWhiteSpace(Model.Phone) && Model.TelephoneHref == null) { <section><h2>Telefon</h2><p>@Model.Phone</p></section> }
    </div>
    <div id="placeDetailsMap" class="places-details__map places-leaflet-map" data-latitude="@Model.Latitude.ToString(System.Globalization.CultureInfo.InvariantCulture)" data-longitude="@Model.Longitude.ToString(System.Globalization.CultureInfo.InvariantCulture)" data-category="@((int)Model.Category)" data-category-label="@Model.CategoryLabel" data-category-key="@Model.CategoryKey" data-icon-class="@Model.IconClass" data-is-commercial="@Model.IsCommercial.ToString().ToLowerInvariant()" data-logo-url="@Model.LogoUrl" aria-label="Lokacija na zemljevidu"></div>
</main>
@section Scripts {
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
    <partial name="_MapBasemapScripts" />
    <script src="~/js/place-marker.js" asp-append-version="true"></script>
    <script src="~/js/place-details.js" asp-append-version="true"></script>
}
