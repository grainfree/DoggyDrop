@model DoggyDrop.Services.WaterImportPage
@using DoggyDrop.Services
@using System.Globalization
@{ ViewData["Title"] = "Predogled uvoza"; }
@section Styles {
    <link rel="stylesheet" href="~/css/places.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/bin-import.css" asp-append-version="true" />
}
<main class="places-page bin-import">
    <h1>Predogled uvoza</h1>
    <partial name="_Context" model="Model" />
    @if (TempData["ImportMessage"] is string message) { <p role="alert">@message</p> }
    <p>Skupaj: @Model.Total · Pripravljeno: @Model.Ready · Možni dvojniki: @Model.Duplicates · Neveljavno: @Model.Invalid</p>
    <p><strong>Izbranih v celotni datoteki: @Model.Selected.Count.</strong> Privzeto so izbrane vse pripravljene vrstice na vseh straneh. Možni dvojniki in neveljavne vrstice so izključeni. Ni prisilnega uvoza dvojnikov.</p>
    <p>Prikazanih je do 100 vrstic. Pred menjavo strani shrani izbor; izbor drugih strani ostane shranjen. Razdalja za možne dvojnike je 15 m; prikazani so do trije primeri na vrstico.</p>
    <form asp-action="Select" asp-route-id="@Model.Id" method="post">
        <input type="hidden" name="version" value="@Model.Version" /><input type="hidden" name="page" value="@Model.Page" />
        <div class="import-rows">
        @foreach (var row in Model.Rows)
        {
            <article>
                <h2>Vrstica @row.Number · @(string.IsNullOrWhiteSpace(row.Name) ? "Pitnik (brez imena)" : row.Name)</h2>
                <p>Dostop: @row.Access · Sezonskost: @row.Seasonality · Psi: @row.DogAccess · Voda: @row.Potability</p>
                <p>@(row.Status == ImportRowStatus.Ready ? "READY — Pripravljeno" : row.Status == ImportRowStatus.PossibleDuplicate ? "POSSIBLE_DUPLICATE — Možni dvojnik" : "INVALID — Neveljavno")</p>
                <p>Latitude: @(row.Latitude?.ToString("G", CultureInfo.InvariantCulture) ?? "—") · Longitude: @(row.Longitude?.ToString("G", CultureInfo.InvariantCulture) ?? "—")</p>
                @if (row.Error != null) { <p>@row.Error</p> }
                @if (row.Status == ImportRowStatus.Ready) { <label class="import-check"><input type="checkbox" name="rows" value="@row.Number" checked="@Model.Selected.Contains(row.Number)" /> Uvozi vrstico @row.Number</label> }
                @foreach (var candidate in row.Candidates)
                {
                    <p>@(candidate.WaterPointId.HasValue ? $"Obstoječi pitnik #{candidate.WaterPointId}" : $"Prejšnja vrstica CSV {candidate.RowNumber}"): @candidate.Name · @candidate.Metres.ToString("0.0") m
                    @if (candidate.WaterPointId.HasValue) { <span> · <a asp-controller="AdminWaterPoints" asp-action="Edit" asp-route-id="@candidate.WaterPointId" target="_blank" rel="noopener">Odpri zapis (nov zavihek)</a></span> }</p>
                }
            </article>
        }
        </div>
        <div class="import-actions"><button type="submit" class="places-button">Shrani izbor strani</button><button type="submit" name="proceed" value="true" class="places-button places-button--primary">Shrani izbor in nadaljuj na potrditev</button></div>
    </form>
    <nav class="import-actions" aria-label="Strani predogleda">
        @if (Model.Page > 1) { <a asp-route-id="@Model.Id" asp-route-page="@(Model.Page - 1)">Prejšnja</a> }
        <span>Stran @Model.Page / @((Model.Total + 99) / 100)</span>
        @if (Model.Page * 100 < Model.Total) { <a asp-route-id="@Model.Id" asp-route-page="@(Model.Page + 1)">Naslednja</a> }
    </nav>
    <form asp-action="Refresh" asp-route-id="@Model.Id" method="post"><input type="hidden" name="version" value="@Model.Version" /><button type="submit" class="places-button">Ponovno preveri dvojnike</button></form>
    <form asp-action="Cancel" asp-route-id="@Model.Id" method="post"><button type="submit" class="places-button">Prekliči uvoz</button></form>
</main>
