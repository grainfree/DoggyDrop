@model IReadOnlyList<DoggyDrop.ViewModels.AdminBinRow>
@using DoggyDrop.ViewModels
@{ ViewData["Title"] = "Koši — viri podatkov"; int page = ViewBag.Page; }
@section Styles {
    <link rel="stylesheet" href="~/css/places.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/data-admin.css" asp-append-version="true" />
}
<main class="places-page data-admin">
    <h1>Koši — viri podatkov</h1>
    <partial name="_DataAdminLinks" />
    <p><a class="places-button" asp-action="ExportComparison">Izvozi koše za primerjavo</a></p>
    <p>CSV vsebuje samo infrastrukturne podatke za preverjanje dvojnikov in virov. Vključeni so vsi odobreni koši in koši, ki čakajo na odobritev, ne glede na spodnje filtre.</p>
    <p>Odobritev košev ostaja v <a asp-controller="Map" asp-action="Manage">obstoječi čakalnici</a>. Skupinska dejanja spreminjajo samo vir.</p>
    @if (TempData["DataMessage"] is string message) { <p role="status">@message</p> }
    <form method="get" class="places-filters">
        <label>Stanje<select name="state">
            <option value="">Vsa stanja</option>
            <option value="approved" selected="@(ViewBag.State == "approved")">Odobreno</option>
            <option value="pending" selected="@(ViewBag.State == "pending")">Čaka na odobritev</option>
        </select></label>
        <partial name="_DataSourceFilter" />
        <button type="submit" class="places-button">Filtriraj</button>
    </form>
    <partial name="_DataBulkForm" model="BulkTarget.Bins" />
    <div class="data-records">
        @foreach (var bin in Model)
        {
            <article>
                <label class="data-check"><input type="checkbox" name="Ids" value="@bin.Id" form="dataBulkForm" /> Izberi koš #@bin.Id: @bin.Name</label>
                <p>@(bin.IsApproved ? "Odobreno" : "Čaka na odobritev") · Vir: @(bin.SourceName ?? "Vir ni določen")</p>
                <a class="places-button" asp-controller="Map" asp-action="Edit" asp-route-id="@bin.Id">Uredi koš</a>
                <a class="places-button" asp-controller="AdminDuplicates" asp-action="Index" asp-route-target="Bins">Pregled dvojnikov</a>
            </article>
        }
    </div>
    @if (Model.Count == 0) { <p>Ni košev za izbrani filter.</p> }
    <nav class="data-pages" aria-label="Strani košev">
        @if (page > 1) { <a asp-route-page="@(page - 1)" asp-route-state="@ViewBag.State" asp-route-sourceId="@ViewBag.SourceId" asp-route-noSource="@ViewBag.NoSource">Prejšnja</a> }
        <span>Stran @(page)</span>
        @if (ViewBag.HasNext == true) { <a asp-route-page="@(page + 1)" asp-route-state="@ViewBag.State" asp-route-sourceId="@ViewBag.SourceId" asp-route-noSource="@ViewBag.NoSource">Naslednja</a> }
    </nav>
</main>
