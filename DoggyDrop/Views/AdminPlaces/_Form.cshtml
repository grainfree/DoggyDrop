@model DoggyDrop.ViewModels.PlaceInput

<div asp-validation-summary="ModelOnly" class="places-validation" role="alert"></div>
<div class="places-form-grid">
    <label class="places-field">Vir zapisa
        <select asp-for="DataSourceId">
            <option value="">Vir ni določen</option>
            @foreach (var source in (IReadOnlyList<DoggyDrop.ViewModels.SourceOption>)(ViewBag.DataSources ?? new List<DoggyDrop.ViewModels.SourceOption>()))
            {
                <option value="@source.Id">@source.Name</option>
            }
        </select>
        <span asp-validation-for="DataSourceId"></span>
        <small>Izvor zapisa; vir dokazov za ugodnosti za pse je ločen podatek.</small>
    </label>
    <label class="places-field">Ime *
        <input asp-for="Name" maxlength="120" required />
        <span asp-validation-for="Name"></span>
    </label>
    <label class="places-field">Kategorija *
        <select asp-for="Category" required>
            <option value="0">Izberi kategorijo</option>
            @foreach (var category in DoggyDrop.Services.PlaceCategories.All)
            {
                <option value="@((int)category.Category)" data-featured-eligible="@category.IsCommercial.ToString().ToLowerInvariant()">@category.Label</option>
            }
        </select>
        <span asp-validation-for="Category"></span>
    </label>
    <label class="places-field">Naslov
        <input asp-for="Address" maxlength="180" />
        <span asp-validation-for="Address"></span>
    </label>
    <label class="places-field">Telefon
        <input asp-for="Phone" type="tel" maxlength="40" />
        <span asp-validation-for="Phone"></span>
    </label>
    <label class="places-field">Spletna stran
        <input asp-for="WebsiteUrl" type="url" maxlength="500" placeholder="https://" />
        <span asp-validation-for="WebsiteUrl"></span>
    </label>
    <label class="places-field">Delovni čas
        <input asp-for="OpeningHours" maxlength="240" />
        <span asp-validation-for="OpeningHours"></span>
    </label>
    <label class="places-field places-field--wide">URL fotografije lokacije (HTTPS)
        <input asp-for="ImageUrl" type="url" maxlength="500" placeholder="https://" />
        <span asp-validation-for="ImageUrl"></span>
    </label>
    <label class="places-field places-field--wide">Opis
        <textarea asp-for="Description" maxlength="2000" rows="4"></textarea>
        <span asp-validation-for="Description"></span>
    </label>
</div>
<section class="place-featured-editor" aria-labelledby="placeFeaturedTitle">
    <h2 id="placeFeaturedTitle">Izpostavitev</h2>
    <p id="placeFeaturedHelp">Izpostavitev vpliva samo na prikaz lokacije in ne pomeni priporočila DoggyDrop.</p>
    <p>Na voljo za veterinarje, trgovine, salone, pasje šole in psom prijazne lokale. Za parke in plaže se nastavitev odstrani.</p>
    <fieldset id="placeFeaturedFields" disabled="@(!DoggyDrop.Services.FeaturedPlaces.IsEligible(Model.Category))" aria-describedby="placeFeaturedHelp placeFeaturedTimeHelp">
        <legend class="visually-hidden">Nastavitve izpostavitve</legend>
        <label class="place-amenities-editor__option"><input asp-for="IsFeatured" /> <span>Izpostavljena lokacija</span></label>
        <div class="places-form-grid">
            <label class="places-field">Od (neobvezno)
                <input asp-for="FeaturedFromLocal" type="datetime-local" step="1" />
                <span asp-validation-for="FeaturedFromLocal"></span>
            </label>
            <label class="places-field">Do (neobvezno)
                <input asp-for="FeaturedUntilLocal" type="datetime-local" step="1" />
                <span asp-validation-for="FeaturedUntilLocal"></span>
            </label>
        </div>
    </fieldset>
    <span asp-validation-for="IsFeatured" class="places-validation"></span>
    <p id="placeFeaturedTimeHelp">Čas v Sloveniji (Europe/Ljubljana). Brez datumov velja neomejeno. Začetek je vključen, ob času konca izpostavitev preneha. Neaktivna lokacija ni javno izpostavljena.</p>
</section>
<section class="place-amenities-editor" aria-labelledby="placeAmenitiesTitle">
    <h2 id="placeAmenitiesTitle">Ugodnosti za pse</h2>
    <p>Označi samo potrjene podatke. Neoznačeno pomeni, da podatek ni potrjen, ne da velja prepoved.</p>
    <div class="place-amenities-editor__groups">
        @foreach (var group in DoggyDrop.Services.PlaceAmenities.All.GroupBy(amenity => amenity.Group))
        {
            <fieldset>
                <legend>@group.Key</legend>
                @foreach (var amenity in group)
                {
                    <label class="place-amenities-editor__option" for="amenity-@((int)amenity.Type)">
                        <input type="checkbox" id="amenity-@((int)amenity.Type)" name="AmenityTypes" value="@((int)amenity.Type)" checked="@(Model.AmenityTypes.Contains(amenity.Type))" />
                        <span>@amenity.Label</span>
                    </label>
                }
            </fieldset>
        }
    </div>
    <span asp-validation-for="AmenityTypes" class="places-validation"></span>
    <label class="places-field">Vir podatkov (samo za skrbnike)
        <input asp-for="AmenitiesSourceUrl" type="url" maxlength="500" placeholder="https://" />
        <span asp-validation-for="AmenitiesSourceUrl"></span>
    </label>
    <p class="place-amenities-editor__verified">@(Model.AmenitiesVerifiedAt.HasValue ? $"Preverjeno: {Model.AmenitiesVerifiedAt.Value.ToString("d. M. yyyy", System.Globalization.CultureInfo.InvariantCulture)} (UTC)" : "Ni podatka o preverjanju")</p>
    <label class="place-amenities-editor__option"><input asp-for="VerifyAmenitiesToday" /> <span>Podatki preverjeni danes</span></label>
    <p class="place-amenities-editor__note">Ob spremembi ugodnosti ali vira ponovno potrdi preverjanje. Datum se shrani ob shranjevanju lokacije.</p>
</section>
<section class="places-logo" aria-labelledby="placeLogoTitle">
    <h2 id="placeLogoTitle">Logotip</h2>
    <p>PNG, JPG ali WebP, največ 5 MB. Logotip se prikaže na zemljevidu.</p>
    <div class="places-logo__preview" id="placeLogoPreview" @(string.IsNullOrWhiteSpace(Model.LogoUrl) ? "hidden" : "")>
        <img id="placeLogoImage" src="@Model.LogoUrl" alt="Trenutni logotip" referrerpolicy="no-referrer" />
    </div>
    <label class="places-field" for="LogoFile">@(string.IsNullOrWhiteSpace(Model.LogoUrl) ? "Izberi logotip" : "Zamenjaj logotip")</label>
    <input asp-for="LogoFile" type="file" accept=".png,.jpg,.jpeg,.webp,image/png,image/jpeg,image/webp" />
    <span asp-validation-for="LogoFile"></span>
    <span id="placeLogoFileName" aria-live="polite"></span>
    @if (!string.IsNullOrWhiteSpace(Model.LogoUrl))
    {
        <label class="places-logo__remove"><input asp-for="RemoveLogo" type="checkbox" /> Odstrani logotip</label>
    }
</section>
<section class="places-location" aria-labelledby="placeLocationTitle">
    <div class="places-location__head">
        <div><h2 id="placeLocationTitle">Lokacija na zemljevidu *</h2><p>Dotakni se zemljevida, da določiš točko.</p></div>
        <button id="placeUseLocation" type="button" class="places-button"><i class="bi bi-crosshair" aria-hidden="true"></i> Trenutna lokacija</button>
    </div>
    <div id="placePickerMap" class="places-picker-map places-leaflet-map" aria-label="Izberi lokacijo na zemljevidu"></div>
    <p id="placePickerStatus" class="places-location__status" role="status"></p>
    <div class="places-form-grid">
        <label class="places-field">Zemljepisna širina *
            <input asp-for="Latitude" type="number" step="any" min="-90" max="90" required />
            <span asp-validation-for="Latitude"></span>
        </label>
        <label class="places-field">Zemljepisna dolžina *
            <input asp-for="Longitude" type="number" step="any" min="-180" max="180" required />
            <span asp-validation-for="Longitude"></span>
        </label>
    </div>
</section>
