@model DoggyDrop.ViewModels.DogsDashboardViewModel
@using DoggyDrop.ViewModels
@using System.Globalization

@{
    ViewData["Title"] = "Moji psi";
    var sl = CultureInfo.GetCultureInfo("sl-SI");
    var dog = Model.SelectedDog;
    var traits = new[]
    {
        new { Name = "Pustolovščina", Value = Model.Progression?.Adventure ?? 0 },
        new { Name = "Družabnost", Value = Model.Progression?.Social ?? 0 },
        new { Name = "Gozd", Value = Model.Progression?.Forest ?? 0 },
        new { Name = "Mesto", Value = Model.Progression?.City ?? 0 },
        new { Name = "Voda", Value = Model.Progression?.Water ?? 0 },
        new { Name = "Hitrost", Value = Model.Progression?.Speed ?? 0 }
    }.Where(item => item.Value > 0).OrderByDescending(item => item.Value).Take(3).ToList();
}

<section class="app-page dogs-dashboard">
    <header class="dogs-dashboard__header">
        <h1>Moji psi</h1>
        @if (dog != null) { <a asp-action="Create" title="Dodaj psa"><i class="bi bi-plus-lg" aria-hidden="true"></i> Dodaj psa</a> }
    </header>
    @if (TempData["SuccessMessage"] != null) { <div class="alert alert-success">@TempData["SuccessMessage"]</div> }
    @if (dog == null)
    {
        <div class="dogs-dashboard__empty">
            <h2>Najprej dodaj svojega psa.</h2>
            <p>Potem bosta tukaj našla skupne sprehode, fotografije in pasji napredek.</p>
            <a asp-action="Create">Dodaj psa</a>
        </div>
    }
    else
    {
        @if (Model.Dogs.Count > 1)
        {
            <nav class="dogs-dashboard__selector" aria-label="Izberi psa">
                @foreach (var item in Model.Dogs)
                {
                    <a asp-action="Index" asp-route-dogId="@item.Id" class="@(item.Id == dog.Id ? "is-active" : "")" aria-current="@(item.Id == dog.Id ? "page" : null)" aria-label="Izberi psa @item.Name" title="@item.Name">
                        @if (!string.IsNullOrWhiteSpace(item.PhotoUrl)) { <img src="@item.PhotoUrl" alt="" /> }
                        else { <span class="dogs-dashboard__selector-avatar">@(string.IsNullOrWhiteSpace(item.Name) ? "P" : item.Name[..1].ToUpperInvariant())</span> }
                        <span class="dogs-dashboard__selector-name">@item.Name</span>
                    </a>
                }
                <a class="dogs-dashboard__selector-add" asp-action="Create" aria-label="Dodaj psa"><i class="bi bi-plus-lg" aria-hidden="true"></i></a>
            </nav>
        }
        <div class="dogs-dashboard__identity">
            <div class="dogs-dashboard__dog">
                <div class="dogs-dashboard__portrait">
                    <span aria-hidden="true">@(string.IsNullOrWhiteSpace(dog.Name) ? "P" : dog.Name[..1].ToUpperInvariant())</span>
                    @if (!string.IsNullOrWhiteSpace(dog.PhotoUrl)) { <img src="@dog.PhotoUrl" alt="@dog.Name" onerror="this.hidden=true" /> }
                </div>
                <div class="dogs-dashboard__intro">
                    <span>Moj pes</span>
                    <h2>@dog.Name</h2>
                    @if (!string.IsNullOrWhiteSpace(dog.Breed)) { <p>@dog.Breed</p> }
                </div>
            </div>
            <div class="dogs-dashboard__facts" aria-label="Skupna aktivnost">
                <div><strong>@Model.CompletedWalkCount</strong><span>sprehodi</span></div>
                <div><strong>@SlovenianFormatting.WalkDistance(Model.TotalDistanceKm * 1000)</strong><span>prehojeno</span></div>
                <div><strong>@Model.ParkLocationCount</strong><span>obiskani parki</span></div>
            </div>
        </div>
        <div class="dogs-dashboard__actions">
            @if (Model.ActiveWalkId.HasValue)
            {
                <a class="dogs-dashboard__primary" asp-controller="Walks" asp-action="Active" asp-route-id="@Model.ActiveWalkId.Value"><i class="bi bi-play-fill" aria-hidden="true"></i> Nadaljuj sprehod</a>
            }
            else
            {
                <form asp-controller="Walks" asp-action="Start" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="dogId" value="@dog.Id" />
                    <button class="dogs-dashboard__primary" type="submit"><i class="bi bi-play-fill" aria-hidden="true"></i> Začni sprehod</button>
                </form>
            }
            <a asp-action="Details" asp-route-id="@dog.Id">Profil psa <i class="bi bi-chevron-right" aria-hidden="true"></i></a>
        </div>
        @if (Model.ActiveWalkId.HasValue && !string.IsNullOrWhiteSpace(Model.ActiveWalkDogName) && Model.ActiveWalkDogName != dog.Name)
        {
            <p class="dogs-dashboard__active-note">Trenutni sprehod poteka s psom @Model.ActiveWalkDogName.</p>
        }
        <section class="dogs-dashboard__section dogs-dashboard__progression">
            <h2>Napredek</h2>
            @if (Model.Level == null)
            {
                <p>Pasji napredek se bo prikazal po prvi dejavnosti.</p>
            }
            else
            {
                <div class="dogs-dashboard__level"><strong>Stopnja @Model.Level.Level</strong><span>@Model.Level.TotalXp / @Model.Level.NextLevelXp XP</span></div>
                <div class="dogs-dashboard__progress" role="progressbar" aria-label="Napredek psa do naslednje stopnje" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@Model.Level.ProgressPercent"><span style="width: @Model.Level.ProgressPercent%"></span></div>
                @if (traits.Count > 0)
                {
                    <div class="dogs-dashboard__traits">
                        @foreach (var trait in traits) { <span>@trait.Name <strong>@trait.Value</strong></span> }
                    </div>
                }
            }
        </section>
        <section class="dogs-dashboard__section">
            <div class="dogs-dashboard__section-head">
                <h2>Nedavni sprehodi</h2>
                <a asp-action="Adventures" asp-route-dogId="@dog.Id">Vsi sprehodi</a>
            </div>
            @if (Model.RecentWalks.Count == 0) { <p>Prvi skupni sprehod vaju še čaka.</p> }
            else
            {
                <div class="dogs-dashboard__walks">
                    @foreach (var walk in Model.RecentWalks)
                    {
                        var localTime = WalkMemoryPresentation.LocalTime(walk.EndedAt ?? walk.StartedAt);
                        <a asp-controller="Walks" asp-action="Details" asp-route-id="@walk.Id">
                            <time datetime="@((walk.EndedAt ?? walk.StartedAt).ToString("O"))">@(localTime.ToString("dd. MM. yyyy", sl))</time>
                            <span class="dogs-dashboard__walk-meta">@(localTime.ToString("HH:mm", sl)) <strong>· @SlovenianFormatting.WalkDistance(walk.DistanceMeters)</strong></span>
                            <i class="bi bi-chevron-right" aria-hidden="true"></i>
                        </a>
                    }
                </div>
            }
        </section>
        <section class="dogs-dashboard__section">
            <h2>Trenutki s psom @dog.Name</h2>
            @if (Model.RecentPhotos.Count == 0) { <p>Fotografije s sprehodov se bodo pojavile tukaj.</p> }
            else
            {
                <div class="dogs-dashboard__photos">
                    @foreach (var photo in Model.RecentPhotos)
                    {
                        <a asp-controller="Walks" asp-action="Details" asp-route-id="@photo.WalkId" aria-label="Odpri sprehod s fotografijo">
                            <span class="dogs-dashboard__photo-fallback">Fotografija ni na voljo</span>
                            <img src="@photo.ImageUrl" alt="@(photo.Caption ?? $"Trenutek s sprehoda psa {dog.Name}")" loading="lazy" onerror="this.hidden=true" />
                        </a>
                    }
                </div>
            }
        </section>
    }
</section>

<style>
    .dogs-dashboard { max-width: 820px; padding-bottom: var(--app-bottom-nav-clearance, 100px); }
    .dogs-dashboard__header { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 12px; }
    .dogs-dashboard__header h1 { margin: 0; color: var(--dd-text); font-family: inherit; font-size: 1.7rem; font-weight: 900; line-height: 1.1; }
    .dogs-dashboard__header a { min-height: 44px; display: inline-flex; align-items: center; gap: 6px; color: var(--dd-primary); font-weight: 800; text-decoration: none; white-space: nowrap; }
    .dogs-dashboard__selector, .dogs-dashboard__photos { display: flex; max-width: 100%; gap: 8px; overflow-x: auto; padding-bottom: 8px; }
    .dogs-dashboard__selector a { display: flex; flex: none; align-items: center; gap: 7px; max-width: min(240px, 72vw); min-height: 44px; padding: 4px 10px; border: 1px solid #d7e2d9; border-radius: 8px; color: #24483b; text-decoration: none; }
    .dogs-dashboard__selector a.is-active { border-color: #24695a; background: #e7f1e9; font-weight: 800; }
    .dogs-dashboard__selector .dogs-dashboard__selector-add { min-width: 46px; justify-content: center; }
    .dogs-dashboard__selector img, .dogs-dashboard__selector-avatar { flex: none; width: 30px; height: 30px; border-radius: 50%; object-fit: cover; }
    .dogs-dashboard__selector-avatar { display: grid; place-items: center; background: #e3efe5; }
    .dogs-dashboard__selector-name { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .dogs-dashboard__identity { margin-top: 10px; padding: 12px 14px 4px; border: 1px solid var(--dd-border); border-radius: var(--dd-radius-lg); background: linear-gradient(135deg, var(--dd-primary-soft), #f7fbf7); box-shadow: 0 10px 26px rgba(20, 40, 35, .08); }
    .dogs-dashboard__dog { display: grid; grid-template-columns: minmax(105px, 34%) minmax(0, 1fr); gap: 14px; align-items: center; }
    .dogs-dashboard__portrait { position: relative; aspect-ratio: 1; display: grid; place-items: center; overflow: hidden; border-radius: var(--dd-radius-md); background: #d8ebdf; color: var(--dd-primary); font-size: 3rem; font-weight: 900; }
    .dogs-dashboard__portrait img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
    .dogs-dashboard__intro { min-width: 0; }
    .dogs-dashboard__intro h2 { margin: 2px 0 6px; color: var(--dd-primary-strong); font-family: inherit; font-size: 1.9rem; font-weight: 900; line-height: 1.08; overflow-wrap: anywhere; }
    .dogs-dashboard__intro p { margin: 3px 0; color: var(--dd-muted); font-weight: 700; }
    .dogs-dashboard__intro span { color: #24695a; font-size: .76rem; font-weight: 800; text-transform: uppercase; }
    .dogs-dashboard__facts { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); margin-top: 10px; border-top: 1px solid rgba(36, 105, 90, .16); }
    .dogs-dashboard__facts div { min-width: 0; padding: 9px 5px; text-align: center; }
    .dogs-dashboard__facts div + div { border-left: 1px solid #dce7df; }
    .dogs-dashboard__facts strong, .dogs-dashboard__facts span { display: block; }
    .dogs-dashboard__facts strong { color: var(--dd-primary-strong); font-size: 1.1rem; font-weight: 900; overflow-wrap: anywhere; }
    .dogs-dashboard__facts span { color: #52665e; font-size: .76rem; }
    .dogs-dashboard__actions { display: grid; grid-template-columns: 1.25fr 1fr; gap: 8px; margin-top: 12px; }
    .dogs-dashboard__actions form { margin: 0; }
    .dogs-dashboard__actions a, .dogs-dashboard__actions button, .dogs-dashboard__empty a { width: 100%; min-height: 48px; display: inline-flex; align-items: center; justify-content: center; gap: 5px; padding: 8px; border: 1px solid #24695a; border-radius: 6px; background: #fff; color: #24695a; font: inherit; font-weight: 800; text-decoration: none; cursor: pointer; }
    .dogs-dashboard__actions .dogs-dashboard__primary, .dogs-dashboard__empty a { background: #24695a; color: #fff; }
    .dogs-dashboard__active-note { margin: 7px 0 0; color: #52665e; font-size: .82rem; }
    .dogs-dashboard__section { margin-top: 18px; }
    .dogs-dashboard__section h2 { margin-bottom: 9px; font-size: 1.12rem; }
    .dogs-dashboard__section-head { display: flex; align-items: baseline; justify-content: space-between; gap: 8px; }
    .dogs-dashboard__section-head a { color: #24695a; font-size: .86rem; font-weight: 800; white-space: nowrap; }
    .dogs-dashboard__section p { color: #52665e; }
    .dogs-dashboard__level { display: flex; justify-content: space-between; gap: 8px; color: #234339; }
    .dogs-dashboard__level span { color: #52665e; }
    .dogs-dashboard__progress { height: 9px; margin-top: 8px; overflow: hidden; border-radius: 5px; background: #e4ebe6; }
    .dogs-dashboard__progress > span { display: block; height: 100%; background: #d8754a; }
    .dogs-dashboard__traits { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 10px; }
    .dogs-dashboard__traits span { padding: 5px 8px; border-radius: 5px; background: #eaf1f4; color: #254a57; font-size: .8rem; }
    .dogs-dashboard__traits strong { margin-left: 3px; }
    .dogs-dashboard__photos a { position: relative; display: grid; flex: 0 0 118px; aspect-ratio: 1; place-items: center; overflow: hidden; border-radius: 7px; background: #eaf1f4; }
    .dogs-dashboard__photo-fallback { padding: 8px; color: #52665e; font-size: .75rem; text-align: center; }
    .dogs-dashboard__photos img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
    .dogs-dashboard__walks a { display: grid; grid-template-columns: minmax(0, 1fr) auto 18px; align-items: center; gap: 8px; min-height: 52px; border-bottom: 1px solid #e4ebe5; color: #263c32; text-decoration: none; }
    .dogs-dashboard__walks time { min-width: 0; font-weight: 800; white-space: nowrap; }
    .dogs-dashboard__walk-meta { color: var(--dd-muted); white-space: nowrap; }
    .dogs-dashboard__walk-meta strong { color: var(--dd-primary-strong); font-weight: 900; }
    .dogs-dashboard__walks i { justify-self: end; color: var(--dd-primary); }
    .dogs-dashboard__empty { max-width: 440px; padding: 28px 0; }
    .dogs-dashboard__empty a { width: fit-content; margin-top: 14px; padding-inline: 20px; }
    @@media (max-width: 420px) { .dogs-dashboard__intro h2 { font-size: 1.65rem; } .dogs-dashboard__facts span { font-size: .7rem; } }
    @@media (max-width: 350px) { .dogs-dashboard__walks a { grid-template-columns: minmax(0, 1fr) 18px; row-gap: 0; padding: 6px 0; } .dogs-dashboard__walk-meta { grid-column: 1; grid-row: 2; } .dogs-dashboard__walks i { grid-column: 2; grid-row: 1 / span 2; } }
</style>
