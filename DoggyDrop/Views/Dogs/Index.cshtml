@model DoggyDrop.ViewModels.DogsDashboardViewModel
@using System.Globalization

@{
    ViewData["Title"] = "Moji psi";
    var sl = CultureInfo.GetCultureInfo("sl-SI");
    var dog = Model.SelectedDog;
}

<section class="app-page dogs-dashboard">
    <header class="dogs-dashboard__header">
        <h1>Moji psi</h1>
        <a asp-action="Create" title="Dodaj psa"><i class="bi bi-plus-lg" aria-hidden="true"></i> Dodaj psa</a>
    </header>
    @if (TempData["SuccessMessage"] != null) { <div class="alert alert-success">@TempData["SuccessMessage"]</div> }
    @if (dog == null)
    {
        <div class="dogs-dashboard__empty">
            <h2>Začnita skupaj</h2>
            <p>Dodaj psa in njegovi sprehodi, trenutki ter napredek bodo zbrani tukaj.</p>
            <a asp-action="Create">Dodaj prvega psa</a>
        </div>
    }
    else
    {
        @if (Model.Dogs.Count > 1)
        {
            <nav class="dogs-dashboard__selector" aria-label="Izberi psa">
                @foreach (var item in Model.Dogs)
                {
                    <a asp-action="Index" asp-route-dogId="@item.Id" class="@(item.Id == dog.Id ? "is-active" : "")" aria-current="@(item.Id == dog.Id ? "page" : null)">
                        @if (!string.IsNullOrWhiteSpace(item.PhotoUrl)) { <img src="@item.PhotoUrl" alt="" /> }
                        else { <span>@(string.IsNullOrWhiteSpace(item.Name) ? "P" : item.Name[..1].ToUpperInvariant())</span> }
                        @item.Name
                    </a>
                }
            </nav>
        }
        <div class="dogs-dashboard__dog">
            <div class="dogs-dashboard__portrait">
                @if (!string.IsNullOrWhiteSpace(dog.PhotoUrl)) { <img src="@dog.PhotoUrl" alt="@dog.Name" /> }
                else { <span>@(string.IsNullOrWhiteSpace(dog.Name) ? "P" : dog.Name[..1].ToUpperInvariant())</span> }
            </div>
            <div class="dogs-dashboard__intro">
                <span>Moj pes</span>
                <h2>@dog.Name</h2>
                <p>@Model.CompletedWalkCount sprehodov · @Model.TotalDistanceKm.ToString("0.#", sl) km</p>
                @if (Model.Level != null) { <p>Stopnja @Model.Level.Level · @Model.Level.TotalXp XP</p> }
            </div>
        </div>
        <div class="dogs-dashboard__actions">
            <a class="dogs-dashboard__primary" asp-controller="Walks" asp-action="Planner" asp-route-dogId="@dog.Id"><i class="bi bi-play-fill" aria-hidden="true"></i> Začni sprehod</a>
            <a asp-action="Details" asp-route-id="@dog.Id">Profil psa <i class="bi bi-chevron-right" aria-hidden="true"></i></a>
        </div>
        <section class="dogs-dashboard__section">
            <h2>@dog.Name - trenutki</h2>
            @if (Model.RecentPhotos.Count == 0) { <p>Fotografije s sprehodov bodo prikazane tukaj.</p> }
            else
            {
                <div class="dogs-dashboard__photos">
                    @foreach (var photo in Model.RecentPhotos)
                    {
                        <a asp-controller="Walks" asp-action="Details" asp-route-id="@photo.WalkId" aria-label="Odpri sprehod s fotografijo">
                            <img src="@photo.ImageUrl" alt="@(photo.Caption ?? $"Trenutek s sprehoda psa {dog.Name}")" loading="lazy" />
                        </a>
                    }
                </div>
            }
        </section>
        <section class="dogs-dashboard__section">
            <h2>Zadnji sprehodi</h2>
            @if (Model.RecentWalks.Count == 0) { <p>Prvi skupni sprehod vaju še čaka.</p> }
            else
            {
                <div class="dogs-dashboard__walks">
                    @foreach (var walk in Model.RecentWalks)
                    {
                        var duration = walk.EndedAt - walk.StartedAt;
                        var showDuration = duration.HasValue && duration.Value.TotalMinutes >= 1 && duration.Value.TotalHours <= 12;
                        <a asp-controller="Walks" asp-action="Details" asp-route-id="@walk.Id">
                            <span>@walk.StartedAt.ToLocalTime().ToString("d. MMMM yyyy", sl)</span>
                            <strong>@(walk.DistanceMeters / 1000).ToString("0.#", sl) km</strong>
                            @if (showDuration) { <small>@Math.Round(duration!.Value.TotalMinutes) min</small> }
                            <i class="bi bi-chevron-right" aria-hidden="true"></i>
                        </a>
                    }
                </div>
            }
        </section>
    }
</section>

<style>
    .dogs-dashboard { max-width: 820px; }
    .dogs-dashboard__header { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 12px; }
    .dogs-dashboard__header h1 { margin: 0; font-size: 1.45rem; }
    .dogs-dashboard__header a { min-height: 44px; display: inline-flex; align-items: center; gap: 6px; color: #24695a; font-weight: 800; text-decoration: none; }
    .dogs-dashboard__selector, .dogs-dashboard__photos { display: flex; gap: 8px; overflow-x: auto; padding-bottom: 8px; }
    .dogs-dashboard__selector a { display: flex; flex: none; align-items: center; gap: 7px; min-height: 44px; padding: 4px 10px; border: 1px solid #d7e2d9; border-radius: 8px; color: #24483b; text-decoration: none; }
    .dogs-dashboard__selector a.is-active { border-color: #24695a; background: #e7f1e9; font-weight: 800; }
    .dogs-dashboard__selector img, .dogs-dashboard__selector span { width: 30px; height: 30px; border-radius: 50%; object-fit: cover; }
    .dogs-dashboard__dog { display: grid; grid-template-columns: minmax(105px, 36%) 1fr; gap: 14px; align-items: center; margin-top: 8px; }
    .dogs-dashboard__portrait { aspect-ratio: 1; display: grid; place-items: center; overflow: hidden; border-radius: 8px; background: #e3efe5; color: #24695a; font-size: 3rem; font-weight: 900; }
    .dogs-dashboard__portrait img { width: 100%; height: 100%; object-fit: cover; }
    .dogs-dashboard__intro h2 { margin: 2px 0 6px; font-size: 1.8rem; overflow-wrap: anywhere; }
    .dogs-dashboard__intro p { margin: 3px 0; color: #52665e; }
    .dogs-dashboard__intro span { color: #24695a; font-size: .76rem; font-weight: 800; text-transform: uppercase; }
    .dogs-dashboard__actions { display: flex; gap: 8px; margin: 12px 0 20px; }
    .dogs-dashboard__actions a, .dogs-dashboard__empty a { flex: 1; min-height: 44px; display: inline-flex; align-items: center; justify-content: center; gap: 5px; padding: 8px; border: 1px solid #24695a; border-radius: 8px; color: #24695a; font-weight: 800; text-decoration: none; }
    .dogs-dashboard__actions .dogs-dashboard__primary, .dogs-dashboard__empty a { background: #24695a; color: #fff; }
    .dogs-dashboard__section { margin-top: 18px; }
    .dogs-dashboard__section h2 { margin-bottom: 9px; font-size: 1.12rem; }
    .dogs-dashboard__section p { color: #52665e; }
    .dogs-dashboard__photos a { flex: 0 0 118px; aspect-ratio: 1; overflow: hidden; border-radius: 7px; }
    .dogs-dashboard__photos img { width: 100%; height: 100%; object-fit: cover; }
    .dogs-dashboard__walks a { display: flex; align-items: center; gap: 10px; min-height: 50px; border-bottom: 1px solid #e4ebe5; color: #263c32; text-decoration: none; }
    .dogs-dashboard__walks strong { margin-left: auto; white-space: nowrap; }
    .dogs-dashboard__walks small { white-space: nowrap; color: #687a70; }
    .dogs-dashboard__empty { padding: 28px 12px; text-align: center; }
    .dogs-dashboard__empty a { flex: none; width: fit-content; margin: 0 auto; }
    @@media (max-width: 420px) { .dogs-dashboard__intro h2 { font-size: 1.5rem; } }
</style>
