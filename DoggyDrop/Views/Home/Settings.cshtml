@model DoggyDrop.ViewModels.PrivacyZoneSettingsViewModel
@using System.Globalization
@{
    ViewData["Title"] = "Nastavitve";
}

<section class="app-page settings-page">
    <header class="settings-hero">
        <div>
            <span>DoggyDrop</span>
            <h1>Nastavitve</h1>
            <p>Privzeti sloji zemljevida in manj motece obnasanje med testiranjem aplikacije na telefonu.</p>
        </div>
    </header>

    <section class="settings-panel" aria-labelledby="privacyZoneHeading">
        <div class="settings-panel__header">
            <h2 id="privacyZoneHeading">Zasebnost poti</h2>
        </div>
        <p class="settings-muted">Zasebno območje skrije natančne lokacije tvojih poti drugim uporabnikom. Ti še vedno vidiš celoten sprehod in pravilno razdaljo.</p>
        <p class="settings-muted settings-privacy-note">Nastavitev velja tudi za pretekle sprehode. Drugim trenutno ne prikazujemo nobene natančne GPS poti. Ob izklopu se shranjena zasebna lokacija izbriše.</p>
        <p class="settings-muted settings-privacy-note">Ko je območje vključeno, tvoji sprehodi ne prispevajo lokacij na zemljevid skupnosti.</p>
        @if (TempData["SuccessMessage"] is string success)
        {
            <p class="settings-privacy-message" role="status">@success</p>
        }
        @if (TempData["ErrorMessage"] is string error)
        {
            <p class="settings-privacy-message settings-privacy-message--error" role="alert">@error</p>
        }
        <form asp-controller="Home" asp-action="SavePrivacyZone" method="post" id="privacyZoneForm" data-has-zone="@Model.IsEnabled.ToString().ToLowerInvariant()">
            @Html.AntiForgeryToken()
            <label class="settings-row settings-privacy-toggle">
                <span><strong>Zaščiti zasebno lokacijo</strong><small>Lokacijo izberi, ko si na mestu, ki ga želiš zaščititi.</small></span>
                <input type="checkbox" id="privacyZoneEnabled" name="Enabled" value="true" checked="@Model.IsEnabled" />
            </label>
            <div id="privacyZoneControls" class="settings-privacy-controls" hidden="@(!Model.IsEnabled)">
                <input type="hidden" id="privacyLatitude" name="Latitude" value="@(Model.Latitude?.ToString("R", CultureInfo.InvariantCulture))" />
                <input type="hidden" id="privacyLongitude" name="Longitude" value="@(Model.Longitude?.ToString("R", CultureInfo.InvariantCulture))" />
                <button type="button" id="privacyUseLocation" class="settings-privacy-location"><i class="bi bi-crosshair" aria-hidden="true"></i> Uporabi trenutno lokacijo</button>
                <p id="privacyLocationStatus" class="settings-muted" role="status" aria-live="polite">@(Model.IsEnabled ? "Zasebna lokacija je shranjena." : "Lokacija še ni izbrana.")</p>
                <label class="settings-privacy-radius" for="privacyRadius"><strong>Velikost območja</strong></label>
                <select id="privacyRadius" name="RadiusMeters">
                    <option value="200" selected="@(Model.RadiusMeters == 200)">200 m</option>
                    <option value="300" selected="@(Model.RadiusMeters == 300)">300 m</option>
                    <option value="500" selected="@(Model.RadiusMeters == 500)">500 m</option>
                    <option value="1000" selected="@(Model.RadiusMeters == 1000)">1 km</option>
                </select>
            </div>
            <div class="settings-actions">
                <button type="submit" id="privacyZoneSave">Shrani zasebno območje</button>
            </div>
        </form>
    </section>

    <section class="settings-panel" aria-labelledby="nearbyDiscoveryHeading">
        <div class="settings-panel__header">
            <h2 id="nearbyDiscoveryHeading">Obvestila v bližini</h2>
        </div>
        <p class="settings-muted">Izberi območje in DoggyDrop te obvesti, ko je v njem na novo odobren pasji koš. Ne spremljamo tvojega gibanja.</p>
        <p class="settings-muted settings-privacy-note">To območje je ločeno od zasebnega območja poti. Ob spremembi velikosti ali ponovnem vklopu ne pošiljamo obvestil za stare koše.</p>
        <form asp-controller="Home" asp-action="SaveNearbyDiscovery" method="post" id="nearbyDiscoveryForm" data-has-preference="@Model.Discovery.IsEnabled.ToString().ToLowerInvariant()">
            @Html.AntiForgeryToken()
            <label class="settings-row settings-privacy-toggle">
                <span><strong>Obveščaj me o novih lokacijah</strong><small>Izberi območje, ki ga želiš spremljati.</small></span>
                <input type="checkbox" id="nearbyDiscoveryEnabled" name="Enabled" value="true" checked="@Model.Discovery.IsEnabled" />
            </label>
            <div id="nearbyDiscoveryControls" class="settings-privacy-controls" hidden="@(!Model.Discovery.IsEnabled)">
                <input type="hidden" id="nearbyDiscoveryLatitude" name="Latitude" value="@(Model.Discovery.Latitude?.ToString("R", CultureInfo.InvariantCulture))" />
                <input type="hidden" id="nearbyDiscoveryLongitude" name="Longitude" value="@(Model.Discovery.Longitude?.ToString("R", CultureInfo.InvariantCulture))" />
                <button type="button" id="nearbyDiscoveryUseLocation" class="settings-privacy-location"><i class="bi bi-crosshair" aria-hidden="true"></i> Uporabi trenutno lokacijo</button>
                <p id="nearbyDiscoveryLocationStatus" class="settings-muted" role="status" aria-live="polite">@(Model.Discovery.IsEnabled ? "Območje je shranjeno." : "Lokacija še ni izbrana.")</p>
                <label class="settings-privacy-radius" for="nearbyDiscoveryRadius"><strong>Velikost območja</strong></label>
                <select id="nearbyDiscoveryRadius" name="RadiusMeters">
                    <option value="1000" selected="@(Model.Discovery.RadiusMeters == 1000)">1 km</option>
                    <option value="3000" selected="@(Model.Discovery.RadiusMeters == 3000)">3 km</option>
                    <option value="5000" selected="@(Model.Discovery.RadiusMeters == 5000)">5 km</option>
                    <option value="10000" selected="@(Model.Discovery.RadiusMeters == 10000)">10 km</option>
                </select>
                <label class="settings-row" for="nearbyDiscoveryBins">
                    <span><strong>Pasji koši</strong><small>Obvestilo šele po odobritvi novega koša.</small></span>
                    <input type="checkbox" id="nearbyDiscoveryBins" name="BinsEnabled" value="true" checked="@Model.Discovery.BinsEnabled" />
                </label>
            </div>
            <div class="settings-actions">
                <button type="submit" id="nearbyDiscoverySave">Shrani obvestila v bližini</button>
            </div>
        </form>
    </section>

    <article class="settings-panel">
        <div class="settings-panel__header">
            <h2>Zemljevid</h2>
            <span>Shranjeno na tej napravi</span>
        </div>

        <div class="settings-list">
            <label class="settings-row">
                <span>
                    <strong>Pasji kosi</strong>
                    <small>Prikazi odobrene kose na zemljevidu.</small>
                </span>
                <input type="checkbox" data-map-setting="showBins" checked />
            </label>

            <label class="settings-row">
                <span>
                    <strong>Pasji parki</strong>
                    <small>Prikazi vnesene pasje parke po Sloveniji.</small>
                </span>
                <input type="checkbox" data-map-setting="showParks" checked />
            </label>

            <label class="settings-row">
                <span>
                    <strong>Pitniki</strong>
                    <small>Prikazi lokacije za vodo.</small>
                </span>
                <input type="checkbox" data-map-setting="showWater" checked />
            </label>

            <label class="settings-row">
                <span>
                    <strong>Dog friendly lokacije</strong>
                    <small>Kavarne in lokacije, kamor lahko prides s psom.</small>
                </span>
                <input type="checkbox" data-map-setting="showCafes" checked />
            </label>

            <label class="settings-row">
                <span>
                    <strong>Psi v blizini</strong>
                    <small>Za zdaj pripravljeno za kasnejsi social feature.</small>
                </span>
                <input type="checkbox" data-map-setting="showDogs" />
            </label>
        </div>
    </article>

    <article class="settings-panel">
        <div class="settings-panel__header">
            <h2>Testiranje</h2>
            <span>Localhost</span>
        </div>
        <p class="settings-muted">GPS na telefonu bova uredila kasneje prek HTTPS povezave. Do takrat zemljevid, rocni sprehodi, fotografije in statistika delujejo normalno.</p>
        <div class="settings-actions">
            <a asp-controller="Map" asp-action="Index">Odpri zemljevid</a>
            <button type="button" id="resetMapSettings">Ponastavi sloje</button>
        </div>
    </article>

    <article class="settings-panel">
        <div class="settings-panel__header">
            <h2>Obvestila</h2>
            <span>Pripravljeno za push</span>
        </div>

        <div class="settings-list">
            <label class="settings-row">
                <span>
                    <strong>Cas za sprehod</strong>
                    <small>Opomnik za redno dnevno aktivnost.</small>
                </span>
                <input type="checkbox" data-notification-setting="walkReminder" checked />
            </label>

            <label class="settings-row">
                <span>
                    <strong>Pes v blizini</strong>
                    <small>Obvestilo, ko bo social sloj zaznal psa v blizini.</small>
                </span>
                <input type="checkbox" data-notification-setting="nearbyDog" />
            </label>

            <label class="settings-row">
                <span>
                    <strong>Znacka odklenjena</strong>
                    <small>Obvestilo ob novem dosezku.</small>
                </span>
                <input type="checkbox" data-notification-setting="badgeEarned" checked />
            </label>

            <label class="settings-row">
                <span>
                    <strong>Nov kos v blizini</strong>
                    <small>Opomnik, ko bo v okolici dodan nov pasji kos.</small>
                </span>
                <input type="checkbox" data-notification-setting="newBin" />
            </label>
        </div>
    </article>
</section>

<style>
    .settings-hero,
    .settings-panel {
        border: 1px solid rgba(31, 45, 41, 0.1);
        border-radius: 8px;
        background: #ffffff;
        box-shadow: 0 12px 28px rgba(31, 45, 41, 0.08);
    }

    .settings-hero {
        padding: 22px;
    }

    .settings-hero span {
        color: #2f6d5f;
        font-size: 0.78rem;
        font-weight: 900;
        text-transform: uppercase;
    }

    .settings-hero h1 {
        margin: 4px 0 8px;
        font-size: clamp(2rem, 8vw, 3.2rem);
        font-weight: 950;
        line-height: 1;
    }

    .settings-hero p,
    .settings-muted,
    .settings-row small {
        color: #65716d;
    }

    .settings-hero p,
    .settings-muted {
        margin: 0;
    }

    .settings-panel {
        margin-top: 14px;
        padding: 18px;
    }

    .settings-privacy-note { margin-top: 8px; }
    .settings-privacy-toggle { margin-top: 16px; }
    .settings-privacy-controls { display: grid; gap: 10px; margin-top: 12px; }
    .settings-privacy-controls[hidden] { display: none; }
    .settings-privacy-location,
    .settings-privacy-radius + select {
        min-height: 44px;
        padding: 9px 12px;
        border: 1px solid rgba(47, 109, 95, 0.25);
        border-radius: 8px;
        background: #fff;
        color: #245c4d;
    }
    .settings-privacy-location { justify-self: start; font-weight: 800; }
    .settings-privacy-radius { font-weight: 800; }
    .settings-privacy-message { margin: 12px 0 0; color: #245c4d; font-weight: 750; }
    .settings-privacy-message--error { color: #9e352f; }
    #privacyZoneSave:disabled { opacity: .55; cursor: not-allowed; }

    .settings-panel__header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 12px;
    }

    .settings-panel__header h2 {
        margin: 0;
        font-size: 1.1rem;
        font-weight: 950;
    }

    .settings-panel__header span {
        color: #2f6d5f;
        font-size: 0.82rem;
        font-weight: 850;
    }

    .settings-list {
        display: grid;
        gap: 10px;
    }

    .settings-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
        padding: 12px;
        border: 1px solid rgba(31, 45, 41, 0.08);
        border-radius: 8px;
        background: #f8faf7;
    }

    .settings-row strong,
    .settings-row small {
        display: block;
    }

    .settings-row input {
        flex: 0 0 auto;
        width: 24px;
        height: 24px;
        accent-color: #2f6d5f;
    }

    .settings-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 14px;
    }

    .settings-actions a,
    .settings-actions button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 42px;
        padding: 10px 16px;
        border-radius: 999px;
        font-weight: 900;
        text-decoration: none;
    }

    .settings-actions a {
        background: #2f6d5f;
        color: #ffffff;
    }

    .settings-actions button {
        border: 1px solid rgba(47, 109, 95, 0.18);
        background: #ffffff;
        color: #2f6d5f;
    }

    @@media (max-width: 575.98px) {
        .settings-panel__header,
        .settings-row {
            align-items: stretch;
            flex-direction: column;
        }

        .settings-actions a,
        .settings-actions button {
            width: 100%;
        }
    }
</style>

@section Scripts {
    <script>
        const privacyForm = document.getElementById("privacyZoneForm");
        const privacyEnabled = document.getElementById("privacyZoneEnabled");
        const privacyControls = document.getElementById("privacyZoneControls");
        const privacySave = document.getElementById("privacyZoneSave");
        const privacyLatitude = document.getElementById("privacyLatitude");
        const privacyLongitude = document.getElementById("privacyLongitude");
        const privacyStatus = document.getElementById("privacyLocationStatus");
        const hadPrivacyZone = privacyForm.dataset.hasZone === "true";

        function updatePrivacyControls() {
            privacyControls.hidden = !privacyEnabled.checked;
            privacySave.disabled = !privacyEnabled.checked && !hadPrivacyZone;
            privacySave.textContent = privacyEnabled.checked ? "Shrani zasebno območje" : "Izklopi in izbriši območje";
        }

        privacyEnabled.addEventListener("change", updatePrivacyControls);
        updatePrivacyControls();
        document.getElementById("privacyUseLocation").addEventListener("click", () => {
            if (!navigator.geolocation || !window.isSecureContext) {
                privacyStatus.textContent = "Lokacija ni na voljo. Preveri dovoljenje za lokacijo in varno povezavo.";
                return;
            }
            privacyStatus.textContent = "Pridobivam trenutno lokacijo ...";
            navigator.geolocation.getCurrentPosition(position => {
                if (!Number.isFinite(position.coords.accuracy) || position.coords.accuracy > 100) {
                    privacyStatus.textContent = "Lokacija ni dovolj natančna. Poskusi znova zunaj ali ob boljšem GPS-signalu; prejšnja nastavitev je ohranjena.";
                    return;
                }
                privacyLatitude.value = String(position.coords.latitude);
                privacyLongitude.value = String(position.coords.longitude);
                privacyStatus.textContent = "Lokacija je izbrana. Shrani zasebno območje.";
            }, () => {
                privacyStatus.textContent = "Lokacije ni bilo mogoče pridobiti. Prejšnja nastavitev je ohranjena.";
            }, { enableHighAccuracy: true, maximumAge: 0, timeout: 10000 });
        });

        privacyForm.addEventListener("submit", event => {
            if (privacyEnabled.checked && (!privacyLatitude.value || !privacyLongitude.value)) {
                event.preventDefault();
                privacyStatus.textContent = "Najprej izberi lokacijo.";
            }
        });

        const nearbyForm = document.getElementById("nearbyDiscoveryForm");
        const nearbyEnabled = document.getElementById("nearbyDiscoveryEnabled");
        const nearbyControls = document.getElementById("nearbyDiscoveryControls");
        const nearbyLatitude = document.getElementById("nearbyDiscoveryLatitude");
        const nearbyLongitude = document.getElementById("nearbyDiscoveryLongitude");
        const nearbyStatus = document.getElementById("nearbyDiscoveryLocationStatus");
        const nearbySave = document.getElementById("nearbyDiscoverySave");
        const hadNearbyPreference = nearbyForm.dataset.hasPreference === "true";

        function updateNearbyControls() {
            nearbyControls.hidden = !nearbyEnabled.checked;
            nearbySave.disabled = !nearbyEnabled.checked && !hadNearbyPreference;
            nearbySave.textContent = nearbyEnabled.checked ? "Shrani obvestila v bližini" : "Izklopi in izbriši območje";
        }

        nearbyEnabled.addEventListener("change", updateNearbyControls);
        updateNearbyControls();
        document.getElementById("nearbyDiscoveryUseLocation").addEventListener("click", () => {
            if (!navigator.geolocation || !window.isSecureContext) {
                nearbyStatus.textContent = "Lokacija ni na voljo. Preveri dovoljenje in varno povezavo; prejšnja nastavitev je ohranjena.";
                return;
            }
            nearbyStatus.textContent = "Pridobivam trenutno lokacijo ...";
            navigator.geolocation.getCurrentPosition(position => {
                const coords = position.coords;
                if (!Number.isFinite(coords.accuracy) || coords.accuracy > 100 ||
                    !Number.isFinite(coords.latitude) || !Number.isFinite(coords.longitude) ||
                    Math.abs(coords.latitude) > 90 || Math.abs(coords.longitude) > 180) {
                    nearbyStatus.textContent = "Lokacija ni dovolj natančna. Poskusi znova; prejšnja nastavitev je ohranjena.";
                    return;
                }
                nearbyLatitude.value = String(coords.latitude);
                nearbyLongitude.value = String(coords.longitude);
                nearbyStatus.textContent = "Območje je izbrano. Shrani nastavitev.";
            }, () => {
                nearbyStatus.textContent = "Lokacije ni bilo mogoče pridobiti. Prejšnja nastavitev je ohranjena.";
            }, { enableHighAccuracy: true, maximumAge: 0, timeout: 10000 });
        });

        nearbyForm.addEventListener("submit", event => {
            if (nearbyEnabled.checked && (!nearbyLatitude.value || !nearbyLongitude.value)) {
                event.preventDefault();
                nearbyStatus.textContent = "Najprej izberi lokacijo.";
            }
        });

        const settingsPrefix = "doggydrop.map.";
        const notificationPrefix = "doggydrop.notifications.";
        const defaults = {
            showBins: true,
            showParks: true,
            showWater: true,
            showCafes: true,
            showDogs: false
        };
        const notificationDefaults = {
            walkReminder: true,
            nearbyDog: false,
            badgeEarned: true,
            newBin: false
        };

        document.querySelectorAll("[data-map-setting]").forEach(input => {
            const key = input.dataset.mapSetting;
            const stored = localStorage.getItem(settingsPrefix + key);
            input.checked = stored === null ? defaults[key] : stored === "true";

            input.addEventListener("change", () => {
                localStorage.setItem(settingsPrefix + key, input.checked ? "true" : "false");
            });
        });

        document.querySelectorAll("[data-notification-setting]").forEach(input => {
            const key = input.dataset.notificationSetting;
            const stored = localStorage.getItem(notificationPrefix + key);
            input.checked = stored === null ? notificationDefaults[key] : stored === "true";

            input.addEventListener("change", () => {
                localStorage.setItem(notificationPrefix + key, input.checked ? "true" : "false");
            });
        });

        document.getElementById("resetMapSettings").addEventListener("click", () => {
            Object.entries(defaults).forEach(([key, value]) => {
                localStorage.setItem(settingsPrefix + key, value ? "true" : "false");
            });

            document.querySelectorAll("[data-map-setting]").forEach(input => {
                input.checked = defaults[input.dataset.mapSetting];
            });
        });
    </script>
}
