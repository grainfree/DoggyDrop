@model DoggyDrop.ViewModels.NotificationsViewModel

@{
    ViewData["Title"] = "Obvestila";
}

<section class="app-page notifications-page">
    <header class="notifications-hero">
        <div>
            <span>DoggyDrop</span>
            <h1>Obvestila</h1>
            <p>Prijatelji, sprehodi, dosežki in pametni namigi na enem mestu.</p>
        </div>
        @if (Model.UnreadCount > 0)
        {
            <form asp-controller="Notifications" asp-action="MarkAllRead" method="post">
                <button type="submit">Označi vse kot prebrano</button>
            </form>
        }
    </header>

    @if (Model.Notifications.Count == 0)
    {
        <article class="notifications-empty">
            <h2>Še ni obvestil</h2>
            <p>Ko se pojavijo prošnje, odzivi ali dosežki, jih boš videl tukaj.</p>
        </article>
    }
    else
    {
        <div class="notifications-list">
            @foreach (var notification in Model.Notifications)
            {
                var title = DoggyDrop.ViewModels.NotificationPresentation.Title(notification);
                var hasLink = !string.IsNullOrWhiteSpace(notification.LinkUrl) && Url.IsLocalUrl(notification.LinkUrl);
                <article class="notification-card @(notification.IsRead ? "is-read" : "is-unread")" aria-label="@(notification.IsRead ? title : $"Neprebrano: {title}")">
                    <div class="notification-card__icon notification-card__icon--@notification.Type"><i class="bi @GetTypeIcon(notification.Type)" aria-hidden="true"></i></div>
                    <div class="notification-card__content">
                        <div class="notification-card__top">
                            <strong>@title</strong>
                            <time datetime="@DateTime.SpecifyKind(notification.CreatedAt, DateTimeKind.Utc).ToString("O")">@DoggyDrop.ViewModels.NotificationPresentation.Time(notification.CreatedAt, DateTime.UtcNow)</time>
                        </div>
                        <p>@DoggyDrop.ViewModels.NotificationPresentation.Body(notification)</p>
                        <span class="notification-card__category">@GetTypeLabel(notification.Type)</span>
                    </div>
                    @if (!notification.IsRead)
                    {
                        <span class="notification-card__unread" aria-hidden="true"></span>
                    }
                    @if (hasLink)
                    {
                        <i class="bi bi-chevron-right notification-card__chevron" aria-hidden="true"></i>
                        @if (notification.IsRead)
                        {
                            <a class="notification-card__hit" href="@notification.LinkUrl" aria-label="Odpri: @title"></a>
                        }
                        else
                        {
                            <form class="notification-card__hit" asp-controller="Notifications" asp-action="MarkRead" asp-route-id="@notification.Id" method="post">
                                <button type="submit" aria-label="@(notification.Type == "FriendRequest" ? "Poglej prošnjo" : $"Odpri: {title}")"></button>
                            </form>
                        }
                    }
                    else if (!notification.IsRead)
                    {
                        <form class="notification-card__read" asp-controller="Notifications" asp-action="MarkRead" asp-route-id="@notification.Id" method="post">
                            <input type="hidden" name="returnToInbox" value="true" />
                            <button type="submit" aria-label="Označi kot prebrano: @title"><i class="bi bi-check2" aria-hidden="true"></i></button>
                        </form>
                    }
                </article>
            }
        </div>
    }

    @if (Model.SmartCards.Count > 0)
    {
        <section class="notification-smart-grid" aria-label="Namigi in vreme">
            @foreach (var card in Model.SmartCards)
            {
                <article class="smart-card" data-weather-card="@(card.Type == "WeatherAlert" ? "true" : null)">
                    <div class="smart-card__top">
                        <span>@GetTypeLabel(card.Type)</span>
                        <strong>@card.Title</strong>
                    </div>
                    <p>@card.Body</p>
                    @if (!string.IsNullOrWhiteSpace(card.LinkUrl) && Url.IsLocalUrl(card.LinkUrl))
                    {
                        <a href="@card.LinkUrl" aria-label="Odpri: @card.Title"><i class="bi bi-arrow-up-right" aria-hidden="true"></i></a>
                    }
                </article>
            }
        </section>
    }
</section>

@functions {
    private static string GetTypeIcon(string type)
    {
        return type switch
        {
            "FriendRequest" => "bi-person-plus",
            "FriendAccepted" => "bi-people",
            "PlaydateInterest" => "bi-calendar-heart",
            "FriendStartedWalk" => "bi-signpost-2",
            "NewBinNearby" => "bi-trash3",
            "BinApproved" => "bi-check-circle",
            "Achievement" => "bi-award",
            "WalkReminder" => "bi-clock",
            "PopularParkNearby" => "bi-tree",
            "WeatherAlert" => "bi-cloud",
            _ => "bi-bell"
        };
    }

    private static string GetTypeLabel(string type)
    {
        return type switch
        {
            "FriendRequest" => "Prijatelji",
            "FriendAccepted" => "Prijatelji",
            "PlaydateInterest" => "Srečanja",
            "FriendStartedWalk" => "Sprehodi",
            "NewBinNearby" => "Zemljevid",
            "BinApproved" => "Prispevek",
            "Achievement" => "Dosežek",
            "WalkReminder" => "Namig",
            "PopularParkNearby" => "Namig",
            "WeatherAlert" => "Vreme",
            _ => "DoggyDrop"
        };
    }
}

<style>
    .notifications-hero,
    .notification-card,
    .notifications-empty {
        border: 1px solid rgba(31, 45, 41, 0.08);
        border-radius: 8px;
        background: #fff;
    }

    .notifications-hero {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        padding: 14px 16px;
    }

    .notifications-hero span {
        color: #2f6d5f;
        font-size: 0.78rem;
        font-weight: 900;
        text-transform: uppercase;
    }

    .notifications-hero h1 {
        margin: 4px 0 8px;
        font-size: 1.55rem;
        font-weight: 950;
        line-height: 1;
    }

    .notifications-hero p,
    .notifications-empty p,
    .notification-card p {
        margin: 0;
        color: #65716d;
    }

    .notifications-hero button {
        min-height: 44px;
        padding: 8px 16px;
        border: 1px solid rgba(47, 109, 95, 0.18);
        border-radius: 8px;
        background: #eef6ef;
        color: #2f6d5f;
        font-weight: 800;
    }

    .notification-smart-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 230px), 1fr));
        gap: 8px;
        margin-top: 18px;
    }

    .notifications-list {
        display: grid;
        gap: 6px;
    }

    .smart-card {
        position: relative;
        min-width: 0;
        padding: 10px 12px;
        border: 1px solid rgba(31, 45, 41, 0.08);
        border-radius: 8px;
        background: #f6f8f5;
    }

    .smart-card__top {
        display: grid;
        gap: 1px;
    }

    .smart-card__top span {
        color: #2f6d5f;
        font-size: 0.68rem;
        font-weight: 900;
        text-transform: uppercase;
    }

    .smart-card__top strong {
        color: #1f2d29;
        font-size: .92rem;
        font-weight: 850;
    }

    .smart-card p {
        margin: 3px 26px 0 0;
        color: #65716d;
        font-size: .78rem;
        line-height: 1.35;
    }

    .smart-card a {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: flex-end;
        padding: 12px;
        color: #2f6d5f;
        text-decoration: none;
    }

    .notification-card {
        position: relative;
        display: grid;
        grid-template-columns: 36px minmax(0, 1fr) auto;
        gap: 9px;
        align-items: start;
        min-height: 80px;
        padding: 10px 12px;
    }

    .notification-card.is-unread {
        border-color: rgba(47, 109, 95, 0.22);
        background: #f2f9f1;
    }

    .notification-card__icon {
        display: grid;
        width: 36px;
        aspect-ratio: 1;
        place-items: center;
        border-radius: 8px;
        background: #eef7ed;
        color: #2f6d5f;
        font-size: 1rem;
    }

    .notification-card__icon--Achievement { background: #fff2da; color: #815418; }
    .notification-card__icon--BinApproved { background: #e5f4ed; color: #176146; }
    .notification-card__icon--FriendRequest,
    .notification-card__icon--FriendAccepted { background: #eaf2fa; color: #245979; }

    .notification-card__content { min-width: 0; }

    .notification-card__top {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 6px;
    }

    .notification-card__top strong {
        color: #1f2d29;
        font-size: .9rem;
        font-weight: 850;
        line-height: 1.25;
        overflow-wrap: anywhere;
    }

    .notification-card__top time {
        flex: 0 0 auto;
        color: #68736d;
        font-size: .68rem;
        white-space: nowrap;
    }

    .notification-card p {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        margin: 2px 0 0;
        font-size: .8rem;
        line-height: 1.3;
    }

    .notification-card__category { color: #52705f; font-size: .68rem; font-weight: 750; }
    .notification-card__unread {
        position: absolute;
        top: 12px;
        right: 9px;
        width: 7px;
        height: 7px;
        overflow: hidden;
        border-radius: 50%;
        background: #2f6d5f;
        color: transparent;
        font-size: 0;
    }
    .notification-card__chevron { align-self: center; margin-right: 2px; color: #587363; font-size: .8rem; }
    .notification-card__hit { position: absolute; inset: 0; margin: 0; }
    .notification-card__hit button { width: 100%; height: 100%; padding: 0; border: 0; background: transparent; }
    .notification-card__hit:focus-visible,
    .notification-card__hit button:focus-visible,
    .smart-card a:focus-visible { outline: 2px solid #2f6d5f; outline-offset: -3px; }
    .notification-card__read { align-self: center; margin: 0; }
    .notification-card__read button {
        display: grid;
        width: 44px;
        height: 44px;
        place-items: center;
        border: 1px solid #c8dacd;
        border-radius: 8px;
        background: #fff;
        color: #2f6d5f;
    }

    @@media (max-width: 575.98px) {
        .notifications-hero { padding: 10px 12px; }
        .notifications-hero h1 { font-size: 1.35rem; }
        .notifications-hero p { display: none; }
        .notification-card__top { flex-wrap: wrap; }
        .notification-card__top time { order: -1; width: 100%; }
    }
</style>

@section Scripts {
    <script>
        const weatherCard = document.querySelector("[data-weather-card]");

        async function loadWeatherAlert() {
            if (!weatherCard || !navigator.geolocation) {
                return;
            }

            navigator.geolocation.getCurrentPosition(async position => {
                try {
                    const latitude = position.coords.latitude.toFixed(4);
                    const longitude = position.coords.longitude.toFixed(4);
                    const response = await fetch(`https://api.open-meteo.com/v1/forecast?latitude=${latitude}&longitude=${longitude}&current=temperature_2m,wind_speed_10m,precipitation&timezone=auto`);
                    if (!response.ok) {
                        return;
                    }

                    const data = await response.json();
                    const current = data.current;
                    if (!current) {
                        return;
                    }

                    let title = "Vreme za sprehod izgleda mirno";
                    let body = `Trenutno ${Math.round(current.temperature_2m)}°C in veter ${Math.round(current.wind_speed_10m)} km/h.`;

                    if (current.precipitation > 0.1) {
                        title = "Možen dež med sprehodom";
                        body = `Na tvoji lokaciji je zaznana padavina (${current.precipitation} mm). Vzemi krajšo pot ali počakaj na premor.`;
                    } else if (current.wind_speed_10m >= 30) {
                        title = "Veter je malo močnejši";
                        body = `Veter je okoli ${Math.round(current.wind_speed_10m)} km/h, zato je bolj smiselna krajša in bolj zavetna trasa.`;
                    } else if (current.temperature_2m >= 28) {
                        title = "Topel del dneva";
                        body = `Trenutno je okoli ${Math.round(current.temperature_2m)}°C. Predlagan je sprehod z vodo in senco.`;
                    }

                    weatherCard.querySelector(".smart-card__top strong").textContent = title;
                    weatherCard.querySelector("p").textContent = body;
                } catch {
                }
            });
        }

        loadWeatherAlert();
    </script>
}
