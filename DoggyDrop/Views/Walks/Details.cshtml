@section Scripts {
    @if (memory.HasMap)
    {
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
            integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
            crossorigin=""></script>
    }

    <script>
        const summaryPoints = @pointsJson;
        const savedPlanPoints = @plannedPointsJson;

        document.addEventListener("DOMContentLoaded", function () {
            const validPoints = points => points
                .map(point => [Number(point.latitude), Number(point.longitude)])
                .filter(([lat, lng]) => Number.isFinite(lat) && Number.isFinite(lng) && Math.abs(lat) <= 90 && Math.abs(lng) <= 180);
            const routePoints = @JsonSerializer.Serialize(memory.HasActualTrail) ? validPoints(summaryPoints) : [];
            const planPoints = @JsonSerializer.Serialize(memory.HasPlannedRoute) ? validPoints(savedPlanPoints) : [];
            const mapElement = document.getElementById("summaryMap");
            if (!mapElement || typeof L === "undefined") return;
            const fallback = routePoints[0] || planPoints[0];
            const map = L.map(mapElement).setView(fallback, routePoints.length > 0 ? 15 : 13);

            L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
                maxZoom: 19,
                attribution: "&copy; OpenStreetMap"
            }).addTo(map);

            if (planPoints.length > 1) {
                L.polyline(planPoints, { color: "#b36f25", weight: 4, opacity: 0.8, dashArray: "8 8" }).addTo(map);
            }
            if (routePoints.length > 0) {
                const routeLine = L.polyline(routePoints, { color: "#2f6d5f", weight: 6, opacity: 0.9 }).addTo(map);
                L.marker(routePoints[0]).addTo(map).bindPopup("Začetek");
                L.marker(routePoints[routePoints.length - 1]).addTo(map).bindPopup("Cilj");
            }
            const visiblePoints = routePoints.length > 1 ? routePoints : planPoints;
            const bounds = visiblePoints.length > 1 ? L.latLngBounds(visiblePoints) : null;
            let refreshFrame = null;
            let framed = false;
            let userMoved = false;
            let fitting = false;
            let lastSize = null;
            map.on("dragstart", () => { userMoved = true; });
            map.on("zoomstart", () => { if (!fitting) userMoved = true; });
            function refreshSummaryMap() {
                if (refreshFrame !== null) cancelAnimationFrame(refreshFrame);
                refreshFrame = requestAnimationFrame(() => {
                    refreshFrame = null;
                    const size = [mapElement.clientWidth, mapElement.clientHeight];
                    const sizeChanged = !lastSize || Math.abs(size[0] - lastSize[0]) > 24 || Math.abs(size[1] - lastSize[1]) > 24;
                    lastSize = size;
                    map.invalidateSize({ pan: false });
                    if (!userMoved && bounds?.isValid() && (!framed || sizeChanged) && size[0] > 0 && size[1] > 0) {
                        fitting = true;
                        try { map.fitBounds(bounds.pad(0.2), { maxZoom: 17, animate: false }); }
                        finally { fitting = false; }
                        framed = true;
                    }
                });
            }
            refreshSummaryMap();
            window.setTimeout(refreshSummaryMap, 150);
            window.addEventListener("load", refreshSummaryMap, { once: true });
            window.addEventListener("orientationchange", refreshSummaryMap);
            if ("ResizeObserver" in window) new ResizeObserver(refreshSummaryMap).observe(mapElement);
        });

        const gallery = document.getElementById("walkPhotoGallery");
        const slides = Array.from(document.querySelectorAll("[data-gallery-slide]"));
        const openButtons = Array.from(document.querySelectorAll("[data-gallery-index]"));
        const closeGalleryButton = document.getElementById("closeWalkGallery");
        const prevGalleryButton = document.getElementById("walkGalleryPrev");
        const nextGalleryButton = document.getElementById("walkGalleryNext");
        let activeGalleryIndex = 0;
        let touchStartX = null;

        function showGallerySlide(index) {
            if (!slides.length) {
                return;
            }

            activeGalleryIndex = (index + slides.length) % slides.length;
            slides.forEach((slide, slideIndex) => {
                slide.classList.toggle("is-active", slideIndex === activeGalleryIndex);
            });
        }

        function openGallery(index) {
            if (!gallery) {
                return;
            }

            gallery.hidden = false;
            document.body.style.overflow = "hidden";
            showGallerySlide(index);
        }

        function closeGallery() {
            if (!gallery) {
                return;
            }

            gallery.hidden = true;
            document.body.style.overflow = "";
        }

        openButtons.forEach(button => {
            button.addEventListener("click", function () {
                openGallery(Number(button.dataset.galleryIndex || "0"));
            });
        });

        closeGalleryButton?.addEventListener("click", closeGallery);
        prevGalleryButton?.addEventListener("click", function () { showGallerySlide(activeGalleryIndex - 1); });
        nextGalleryButton?.addEventListener("click", function () { showGallerySlide(activeGalleryIndex + 1); });

        gallery?.addEventListener("click", function (event) {
            if (event.target === gallery) {
                closeGallery();
            }
        });

        gallery?.addEventListener("touchstart", function (event) {
            touchStartX = event.changedTouches[0].clientX;
        }, { passive: true });

        gallery?.addEventListener("touchend", function (event) {
            if (touchStartX === null) {
                return;
            }

            const deltaX = event.changedTouches[0].clientX - touchStartX;
            touchStartX = null;

            if (Math.abs(deltaX) < 40) {
                return;
            }

            if (deltaX > 0) {
                showGallerySlide(activeGalleryIndex - 1);
            } else {
                showGallerySlide(activeGalleryIndex + 1);
            }
        }, { passive: true });
    </script>
    @if (memory.ShareAsset != null)
    {
        <script src="~/js/walk-share.js" asp-append-version="true" defer></script>
    }
}

