@model DoggyDrop.Models.Walk
@using Microsoft.AspNetCore.Identity
@using DoggyDrop.ViewModels
@using System.Text.Json
@inject UserManager<DoggyDrop.Models.ApplicationUser> UserManager

@{
    var memory = (WalkMemoryViewModel)ViewBag.WalkMemory;
    ViewData["Title"] = memory.Title;
    var currentUserId = UserManager.GetUserId(User);
    var isOwner = currentUserId == Model.OwnerId;
    var showFirstWalkCelebration = isOwner && TempData[$"FirstWalk:Show:{Model.Id}"] as bool? == true;
    var firstWalkDistanceKm = isOwner ? TempData[$"FirstWalk:DistanceKm:{Model.Id}"] as string : null;
    var rewardResult = ViewBag.WalkRewardResult as DoggyDrop.ViewModels.GamificationRewardResultViewModel;
    var visibleRewardAchievements = rewardResult?.GetVisibleAchievements(showFirstWalkCelebration) ?? [];
    var duration = Model.EndedAt.HasValue ? Model.EndedAt.Value - Model.StartedAt : TimeSpan.Zero;
    var distanceLabel = memory.DistanceLabel;
    var detailsShareUrl = Url.Action("Details", "Walks", new { id = Model.Id }, Context.Request.Scheme);
    var reactions = Model.Reactions ?? Array.Empty<DoggyDrop.Models.WalkReaction>();
    var comments = (Model.Comments ?? Array.Empty<DoggyDrop.Models.WalkComment>())
        .Where(comment => !comment.IsDeleted)
        .OrderByDescending(comment => comment.CreatedAt)
        .ToList();
    var walkPhotos = (Model.Photos ?? Array.Empty<DoggyDrop.Models.WalkPhoto>())
        .Where(photo => photo.WalkId == Model.Id && photo.UserId == Model.OwnerId && !string.IsNullOrWhiteSpace(photo.ImageUrl))
        .OrderByDescending(photo => photo.CreatedAt)
        .ThenByDescending(photo => photo.Id)
        .ToList();
    var likedPhotoIds = walkPhotos
        .Where(photo => !string.IsNullOrWhiteSpace(currentUserId) && (photo.Reactions?.Any(reaction => reaction.UserId == currentUserId) ?? false))
        .Select(photo => photo.Id)
        .ToHashSet();
    var currentUserReactionType = !string.IsNullOrWhiteSpace(currentUserId)
        ? reactions.FirstOrDefault(reaction => reaction.UserId == currentUserId)?.ReactionType
        : null;
    var reactionCounts = reactions
        .GroupBy(reaction => reaction.ReactionType)
        .ToDictionary(group => group.Key, group => group.Count());
    var points = (Model.Points ?? Array.Empty<DoggyDrop.Models.WalkPoint>())
        .OrderBy(point => point.RecordedAt)
        .Select(point => new
        {
            latitude = point.Latitude,
            longitude = point.Longitude
        });
    var plannedStops = (Model.PlannedWalk?.Stops ?? Array.Empty<DoggyDrop.Models.PlannedWalkStop>())
        .OrderBy(stop => stop.Order)
        .ToList();
    var completedStops = (Model.StopCompletions ?? Array.Empty<DoggyDrop.Models.WalkStopCompletion>())
        .Where(completion => completion.PlannedWalkStop != null)
        .OrderBy(completion => completion.PlannedWalkStop!.Order)
        .ToList();
    var completedStopIds = completedStops
        .Select(completion => completion.PlannedWalkStopId)
        .ToHashSet();
    var pointsJson = Html.Raw(JsonSerializer.Serialize(points));
    var plannedPointsJson = Html.Raw(JsonSerializer.Serialize((Model.PlannedWalk?.RoutePoints ?? [])
        .OrderBy(point => point.Order)
        .Select(point => new { latitude = point.Latitude, longitude = point.Longitude })));
}

@section Styles {
    @if (memory.HasMap)
    {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
          integrity="sha256-p4NxAoJBhIINfQXh6ULpR5txR9wra5I3BcVsTPY1p3A="
          crossorigin="" />
    }
    <style>
        .first-walk-celebration {
            display: grid;
            grid-template-columns: auto 1fr;
            gap: 16px;
            align-items: start;
            margin-bottom: 18px;
            padding: 18px;
            border: 1px solid rgba(239, 143, 66, 0.18);
            border-radius: 24px;
            background:
                radial-gradient(circle at top right, rgba(239, 143, 66, 0.16), transparent 32%),
                linear-gradient(180deg, rgba(255, 251, 243, 0.98), rgba(255, 255, 255, 0.98));
            box-shadow: 0 18px 40px rgba(31, 45, 41, 0.10);
        }

        .first-walk-celebration__badge {
            width: 58px;
            height: 58px;
            border-radius: 18px;
            display: grid;
            place-items: center;
            background: rgba(47, 109, 95, 0.12);
            color: #ef8f42;
            font-size: 1.5rem;
        }

        .first-walk-celebration__eyebrow {
            display: inline-block;
            margin-bottom: 8px;
            color: #ef8f42;
            font-size: 0.78rem;
            font-weight: 900;
            letter-spacing: 0.05em;
            text-transform: uppercase;
        }

        .first-walk-celebration h2 {
            margin: 0 0 8px;
            color: #1f2d29;
            font-size: 1.2rem;
            font-weight: 900;
        }

        .first-walk-celebration p {
            margin: 0;
            color: #5d6d67;
            line-height: 1.55;
        }

        .first-walk-celebration__actions {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            align-items: center;
            margin-top: 14px;
        }

        .first-walk-celebration__pill {
            display: inline-flex;
            align-items: center;
            padding: 7px 12px;
            border-radius: 999px;
            background: rgba(47, 109, 95, 0.10);
            color: #2f6d5f;
            font-size: 0.82rem;
            font-weight: 900;
        }

        .walk-rewards {
            margin: 18px 0;
            overflow: hidden;
            border: 1px solid rgba(47, 109, 95, 0.16);
            border-radius: 20px;
            background: #ffffff;
            box-shadow: 0 18px 38px rgba(31, 45, 41, 0.09);
        }

        .walk-rewards__header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 14px;
            padding: 18px 20px;
            background: linear-gradient(135deg, rgba(227, 240, 233, 0.95), rgba(255, 240, 223, 0.88));
        }

        .walk-rewards__header span,
        .walk-rewards__header h2,
        .walk-reward-item strong,
        .walk-reward-item span,
        .walk-reward-item p,
        .walk-next-goal strong,
        .walk-next-goal span,
        .walk-next-goal p {
            display: block;
            margin: 0;
        }

        .walk-rewards__header span {
            color: #2f6d5f;
            font-size: 0.76rem;
            font-weight: 900;
            text-transform: uppercase;
        }

        .walk-rewards__header h2 {
            margin-top: 3px;
            color: #1f2d29;
            font-size: 1.35rem;
            font-weight: 950;
        }

        .walk-rewards__header i {
            color: #ef8f42;
            font-size: 1.8rem;
        }

        .walk-rewards__level-up {
            padding: 20px;
            background: #2f6d5f;
            color: #ffffff;
            text-align: center;
        }

        .walk-rewards__level-up span,
        .walk-rewards__level-up strong,
        .walk-rewards__level-up em {
            display: block;
        }

        .walk-rewards__level-up span {
            font-size: 0.76rem;
            font-style: normal;
            font-weight: 950;
            text-transform: uppercase;
        }

        .walk-rewards__level-up strong {
            margin: 4px 0;
            font-size: 1.65rem;
            font-weight: 950;
        }

        .walk-rewards__level-up em {
            font-size: 0.9rem;
            font-style: normal;
            font-weight: 850;
            opacity: 0.86;
        }

        .walk-rewards__grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 12px;
            padding: 16px;
        }

        .walk-reward-item {
            min-width: 0;
            padding: 16px;
            border: 1px solid rgba(31, 45, 41, 0.09);
            border-radius: 14px;
            background: #f8fbf8;
        }

        .walk-reward-item--achievement {
            background: #fff9ef;
        }

        .walk-reward-item--level-up {
            border-color: rgba(239, 143, 66, 0.38);
            background: linear-gradient(145deg, #fff9ef, #f3faf5);
        }

        .walk-reward-item__level-up-label {
            margin-top: 10px;
            color: #c66d28;
            font-size: 0.78rem;
            font-weight: 950;
            text-transform: uppercase;
        }

        .walk-reward-item__top {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
        }

        .walk-reward-item__top > span {
            color: #2f6d5f;
            font-size: 0.76rem;
            font-weight: 900;
            text-transform: uppercase;
        }

        .walk-reward-item__top > strong {
            color: #ef8f42;
            font-size: 1.1rem;
            font-weight: 950;
        }

        .walk-reward-item h3 {
            margin: 10px 0 4px;
            color: #1f2d29;
            font-size: 1.05rem;
            font-weight: 950;
        }

        .walk-reward-item p,
        .walk-reward-item small {
            color: #65716d;
            line-height: 1.45;
        }

        .walk-reward-item__bar,
        .walk-next-goal__bar {
            overflow: hidden;
            height: 9px;
            margin-top: 12px;
            border-radius: 999px;
            background: rgba(47, 109, 95, 0.12);
        }

        .walk-reward-item__bar span,
        .walk-next-goal__bar span {
            height: 100%;
            border-radius: inherit;
            background: linear-gradient(90deg, #2f6d5f, #ef8f42);
        }

        .walk-reward-item__chips {
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
            margin-top: 10px;
        }

        .walk-reward-item__chips span {
            padding: 5px 8px;
            border-radius: 999px;
            background: rgba(47, 109, 95, 0.1);
            color: #2f6d5f;
            font-size: 0.72rem;
            font-weight: 850;
        }

        .walk-reward-item__unlock {
            display: flex;
            gap: 12px;
            align-items: flex-start;
        }

        .walk-reward-item__unlock i {
            color: #ef8f42;
            font-size: 1.45rem;
        }

        .walk-next-goal {
            display: grid;
            grid-template-columns: minmax(0, 1fr) auto;
            gap: 16px;
            align-items: center;
            margin: 0 16px 16px;
            padding: 16px;
            border-radius: 14px;
            background: #1f2d29;
            color: #ffffff;
        }

        .walk-next-goal span {
            color: #f3bd82;
            font-size: 0.75rem;
            font-weight: 900;
            text-transform: uppercase;
        }

        .walk-next-goal strong {
            margin-top: 3px;
            font-size: 1.05rem;
            font-weight: 950;
        }

        .walk-next-goal p {
            margin-top: 5px;
            color: rgba(255, 255, 255, 0.76);
            font-size: 0.88rem;
        }

        .walk-next-goal a {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-height: 42px;
            padding: 10px 14px;
            border-radius: 999px;
            background: #ffffff;
            color: #1f2d29;
            font-size: 0.82rem;
            font-weight: 900;
            text-decoration: none;
        }

        @@media (max-width: 575.98px) {
            .first-walk-celebration {
                grid-template-columns: 1fr;
                padding: 14px;
                border-radius: 18px;
            }

            .first-walk-celebration__actions {
                flex-direction: column;
                align-items: stretch;
            }

            .first-walk-celebration__actions .btn {
                width: 100%;
            }

            .walk-rewards {
                border-radius: 16px;
            }

            .walk-rewards__grid {
                grid-template-columns: 1fr;
                padding: 12px;
            }

            .walk-next-goal {
                grid-template-columns: 1fr;
                margin: 0 12px 12px;
            }

            .walk-next-goal a {
                width: 100%;
            }
        }
        .walk-summary__hero { padding: 14px 18px; border-radius: 10px; }
        .walk-summary__hero h1 { font-size: 1.55rem; }
        .walk-summary__hero p { margin-bottom: 0; }
        .walk-summary__stats { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; }
        .walk-summary__stats article { padding: 10px; border-radius: 8px; }
        .walk-summary__stats strong { font-size: 1.12rem; }
        .walk-summary__top-actions { display: flex; flex-wrap: wrap; gap: 8px; margin: 10px 0 16px; }
        .walk-summary__top-actions button, .walk-summary__top-actions a { min-height: 44px; padding: 10px 15px; border-radius: 8px; font-weight: 800; }
        .walk-summary__top-actions button { border: 0; background: #24695a; color: white; }
        .walk-summary__top-actions a { border: 1px solid #c5d5cc; color: #24695a; text-decoration: none; }
        .walk-memory__cover { position: relative; display: grid; width: 100%; max-height: 280px; aspect-ratio: 16 / 9; place-items: center; overflow: hidden; border-radius: 8px; background: #e3efe5; }
        .walk-memory__cover-fallback { color: #24695a; font-size: 3rem; }
        .walk-memory__cover img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
        .walk-memory__highlights { margin-top: 18px; }
        .walk-memory__highlights h2 { font-size: 1.12rem; }
        .walk-memory__highlight-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; }
        .walk-memory__highlight-list div { display: grid; gap: 3px; min-width: 0; padding: 10px 12px; border: 1px solid #dce7df; border-radius: 6px; }
        .walk-memory__highlight-list span { color: #52665e; font-size: .8rem; }
        .walk-memory__highlight-list strong { overflow-wrap: anywhere; }
        @@media (max-width: 575.98px) { .walk-memory__highlight-list { grid-template-columns: 1fr; } }
    </style>
}

<section class="app-page walk-summary-page">
    @if (currentUserId == Model.OwnerId)
    {
        <a class="walk-summary__back" asp-controller="Dogs" asp-action="Adventures" asp-route-dogId="@Model.DogId">Nazaj na dogodivščine</a>
    }
    else
    {
        <a class="walk-summary__back" asp-controller="Walks" asp-action="Index">Nazaj na sprehode</a>
    }
    @if (TempData["ErrorMessage"] is string uploadError) { <div class="alert alert-danger" role="alert">@uploadError</div> }

    <header class="walk-summary__hero">
        <div>
            <span>Sprehod zaključen</span>
            <h1>@memory.Title</h1>
            <p>@memory.DateLabel</p>
            @if (!string.IsNullOrWhiteSpace(memory.OwnerPlanTitle)) { <p>@memory.OwnerPlanTitle</p> }
        </div>
        <a class="walk-summary__dog-link" asp-controller="Dogs" asp-action="Details" asp-route-id="@Model.DogId">Profil psa</a>
    </header>

    <div class="walk-memory__cover">
        <div class="walk-memory__cover-fallback" aria-hidden="true"><i class="bi bi-signpost-2-fill"></i></div>
        @if (!string.IsNullOrWhiteSpace(memory.HeroPhotoUrl))
        {
            <img src="@memory.HeroPhotoUrl" alt="Fotografija s tega sprehoda" onerror="this.hidden=true" />
        }
    </div>

    <div class="walk-summary__stats">
        <article>
            <strong>@distanceLabel</strong>
            <span>Prehojeno</span>
        </article>
        @if (memory.DurationLabel != null)
        {
            <article>
                <strong>@memory.DurationLabel</strong>
                <span>Od začetka do konca</span>
            </article>
        }
        <article>
            <strong>@memory.PhotoCount</strong>
            <span>Fotografije</span>
        </article>
        @if (Model.UsedBinsCount > 0)
        {
            <article>
                <strong>@Model.UsedBinsCount</strong>
                <span>Prijavljeni koši</span>
            </article>
        }
    </div>

    @if ((Model.Points?.Count ?? 0) < 10 && duration.TotalMinutes >= 10)
    {
        <p class="walk-gps-limited">GPS je med sprehodom zabeležil malo točk. Prikazana razdalja temelji le na shranjenem delu poti.</p>
    }

    <div class="walk-summary__top-actions">
        @if (isOwner) { <button type="button" data-share-walk-story><i class="bi bi-share" aria-hidden="true"></i> Deli sprehod</button> }
        @if (memory.HasMap) { <a href="#summaryMap">Poglej pot</a> }
    </div>

    @if (showFirstWalkCelebration)
    {
        <article class="first-walk-celebration">
            <div class="first-walk-celebration__badge" aria-hidden="true"><i class="bi bi-award-fill"></i></div>
            <div class="first-walk-celebration__content">
                <span class="first-walk-celebration__eyebrow">Prva značka odklenjena</span>
                <h2>Prvi sprehod je za tabo</h2>
                <p>
                    Zaključen je prvi DoggyDrop sprehod s psom @Model.Dog?.Name.
                    @if (!string.IsNullOrWhiteSpace(firstWalkDistanceKm)) { <text>Prehojeno: @distanceLabel.</text> }
                </p>
                <div class="first-walk-celebration__actions">
                    <span class="first-walk-celebration__pill">Prvi sprehod</span>
                    <a class="btn btn-success rounded-pill fw-semibold" asp-controller="Walks" asp-action="Planner" asp-route-dogId="@Model.DogId">Na naslednji sprehod</a>
                    <button type="button" class="btn btn-outline-secondary rounded-pill fw-semibold" data-share-walk-story>Deli dosežek</button>
                </div>
            </div>
        </article>
    }

    @if (rewardResult?.HasRewards == true)
    {
        <article class="walk-rewards" aria-labelledby="walkRewardsTitle">
            <header class="walk-rewards__header">
                <div>
                    <span>Sprehod zaključen</span>
                    <h2 id="walkRewardsTitle">Tvoje nagrade</h2>
                </div>
                <i class="bi bi-stars" aria-hidden="true"></i>
            </header>

            @if (rewardResult.UserReward?.LeveledUp == true)
            {
                <div class="walk-rewards__level-up">
                    <span>Nov nivo</span>
                    <strong>Nivo @rewardResult.UserReward.CurrentLevel · @rewardResult.UserReward.LevelTitle</strong>
                    <em>Odlično napreduješ skozi DoggyDrop.</em>
                </div>
            }

            <div class="walk-rewards__grid">
                @if (rewardResult.UserReward != null)
                {
                    <section class="walk-reward-item">
                        <div class="walk-reward-item__top">
                            <span>Tvoje izkušnje</span>
                            <strong>+@rewardResult.UserReward.XpEarned XP</strong>
                        </div>
                        <h3>Nivo @rewardResult.UserReward.CurrentLevel · @rewardResult.UserReward.LevelTitle</h3>
                        <p>@rewardResult.UserReward.XpRemaining XP do naslednjega nivoja</p>
                        <div class="walk-reward-item__bar" role="progressbar" aria-label="Napredek uporabniškega nivoja" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@rewardResult.UserReward.ProgressPercent">
                            <span style="width: @rewardResult.UserReward.ProgressPercent%"></span>
                        </div>
                    </section>
                }

                @if (rewardResult.DogReward != null)
                {
                    var dogChanges = rewardResult.DogReward.ProgressionChanges.GetVisibleChanges();
                    <section class="walk-reward-item @(rewardResult.DogReward.LeveledUp || rewardResult.DogReward.ClassChanged ? "walk-reward-item--level-up" : string.Empty)">
                        <div class="walk-reward-item__top">
                            <span>@rewardResult.DogReward.DogName</span>
                            <strong>+@rewardResult.DogReward.XpEarned XP</strong>
                        </div>
                        <h3>
                            Nivo @rewardResult.DogReward.CurrentLevel · @rewardResult.DogReward.CurrentClass
                        </h3>
                        @if (rewardResult.DogReward.LeveledUp)
                        {
                            <span class="walk-reward-item__level-up-label">Nov nivo za @rewardResult.DogReward.DogName</span>
                        }
                        else if (rewardResult.DogReward.ClassChanged)
                        {
                            <span class="walk-reward-item__level-up-label">Nov pasji razred</span>
                        }
                        <p>@rewardResult.DogReward.XpRemaining XP do naslednjega nivoja</p>
                        <div class="walk-reward-item__bar" role="progressbar" aria-label="Napredek nivoja psa @rewardResult.DogReward.DogName" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@rewardResult.DogReward.ProgressPercent">
                            <span style="width: @rewardResult.DogReward.ProgressPercent%"></span>
                        </div>
                        @if (dogChanges.Count > 0)
                        {
                            <div class="walk-reward-item__chips">
                                @foreach (var change in dogChanges)
                                {
                                    <span>@change</span>
                                }
                            </div>
                        }
                    </section>
                }

                @if (rewardResult.StreakReward != null)
                {
                    <section class="walk-reward-item">
                        <div class="walk-reward-item__top">
                            <span>Niz sprehodov</span>
                            <strong><i class="bi bi-fire" aria-hidden="true"></i> @SlovenianFormatting.Days(rewardResult.StreakReward.CurrentDays)</strong>
                        </div>
                        <h3>@(rewardResult.StreakReward.Increased ? "Niz se nadaljuje" : "Današnji sprehod je zabeležen")</h3>
                        <p>
                            @if (rewardResult.StreakReward.MilestoneReached.HasValue)
                            {
                                <text>Dosegel si mejnik @rewardResult.StreakReward.MilestoneReached dni zapored.</text>
                            }
                            else
                            {
                                <text>Nov sprehod jutri bo ohranil tvoj ritem.</text>
                            }
                        </p>
                    </section>
                }

                @foreach (var achievement in visibleRewardAchievements)
                {
                    <section class="walk-reward-item walk-reward-item--achievement">
                        <div class="walk-reward-item__unlock">
                            <i class="bi bi-award-fill" aria-hidden="true"></i>
                            <div>
                                <span>Nov dosežek</span>
                                <h3>@achievement.Name</h3>
                                <p>@achievement.Description</p>
                            </div>
                        </div>
                    </section>
                }
            </div>

            @if (rewardResult.NextGoal != null)
            {
                <section class="walk-next-goal">
                    <div>
                        <span>Kaj sledi?</span>
                        <strong>@rewardResult.NextGoal.Title</strong>
                        <p>@rewardResult.NextGoal.Description</p>
                        <div class="walk-next-goal__bar" role="progressbar" aria-label="Napredek naslednjega cilja" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@rewardResult.NextGoal.ProgressPercent">
                            <span style="width: @rewardResult.NextGoal.ProgressPercent%"></span>
                        </div>
                    </div>
                    <a href="@rewardResult.NextGoal.ActionUrl">@rewardResult.NextGoal.ActionLabel</a>
                </section>
            }
        </article>
    }

    @if (memory.Highlights.Count > 0)
    {
        <section class="walk-memory__highlights" aria-labelledby="walkMemoryHighlightsTitle">
            <h2 id="walkMemoryHighlightsTitle">Poudarki</h2>
            <div class="walk-memory__highlight-list">
                @foreach (var highlight in memory.Highlights)
                {
                    <div><span>@highlight.Title</span><strong>@highlight.Detail</strong></div>
                }
            </div>
        </section>
    }

    @if (plannedStops.Count > 0)
    {
        <article class="walk-summary__plan-card">
            <div class="walk-summary__map-header">
                <h2>Planirani postanki</h2>
                <span>@completedStops.Count / @plannedStops.Count opravljeno</span>
            </div>
            <div class="walk-summary__stop-list">
                @foreach (var stop in plannedStops)
                {
                    var wasCompleted = completedStopIds.Contains(stop.Id);
