@model DoggyDrop.Models.Walk
@using System.Text.Json
@using DoggyDrop.ViewModels

@{
    ViewData["Title"] = "Aktiven sprehod";
    var points = (Model.Points ?? Array.Empty<DoggyDrop.Models.WalkPoint>())
        .OrderBy(point => point.RecordedAt)
        .Select(point => new
        {
            latitude = point.Latitude,
            longitude = point.Longitude,
            recordedAt = point.RecordedAt.ToString("O")
        });
    var plannedRoutePoints = (Model.PlannedWalk?.RoutePoints ?? Array.Empty<DoggyDrop.Models.PlannedWalkRoutePoint>())
        .OrderBy(point => point.Order)
        .Select(point => new
        {
            latitude = point.Latitude,
            longitude = point.Longitude
        });
    var plannedStops = (Model.PlannedWalk?.Stops ?? Array.Empty<DoggyDrop.Models.PlannedWalkStop>())
        .OrderBy(stop => stop.Order)
        .Select(stop => new
        {
            stop.Id,
            stop.Name,
            stop.Type,
            stop.Label,
            stop.Reason,
            stop.Latitude,
            stop.Longitude
        });
    var completedStopIds = (Model.StopCompletions ?? Array.Empty<DoggyDrop.Models.WalkStopCompletion>())
        .Select(completion => completion.PlannedWalkStopId)
        .Concat((Model.PlannedWalk?.Stops ?? Array.Empty<DoggyDrop.Models.PlannedWalkStop>())
            .Where(stop => stop.Type == "start")
            .Select(stop => stop.Id))
        .Distinct()
        .ToList();
    var completedStopCount = completedStopIds.Count;
    var debugGpsEnabled = Context.Request.Query["debugGps"].ToString() == "1";
    var plannedStopCount = Model.PlannedWalk?.Stops?.Count ?? 0;
    var walkPhotos = (Model.Photos ?? Array.Empty<DoggyDrop.Models.WalkPhoto>())
        .OrderByDescending(photo => photo.CreatedAt)
        .ToList();
    var pointsJson = Html.Raw(JsonSerializer.Serialize(points));
    var plannedRoutePointsJson = Html.Raw(JsonSerializer.Serialize(plannedRoutePoints));
    var plannedStopsJson = Html.Raw(JsonSerializer.Serialize(plannedStops));
    var completedStopIdsJson = Html.Raw(JsonSerializer.Serialize(completedStopIds));
}

@section Styles {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
          integrity="sha256-p4NxAoJBhIINfQXh6ULpR5txR9wra5I3BcVsTPY1p3A="
          crossorigin="" />
}

<section class="app-page active-walk-page">
    <header class="active-walk-hero">
        <span>Aktiven sprehod</span>
        <h1>@Model.Dog?.Name</h1>
        <p>Začetek: @Model.StartedAt.ToLocalTime().ToString("HH:mm")</p>
        @if (Model.PlannedWalk != null)
        {
            <p>Plan: @Model.PlannedWalk.Title - ~@Model.PlannedWalk.EstimatedMinutes min</p>
        }
    </header>

    <article class="active-walk-map-card">
        <div class="active-walk-map-card__header">
            <div>
                <h2>GPS pot</h2>
                <p id="gpsStatus">GPS še ni zagnan.</p>
            </div>
            <button type="button" id="trackingToggle" class="btn btn-success rounded-pill fw-semibold">Začni GPS zapis</button>
        </div>
        <div id="gpsSecurityWarning" class="gps-security-warning" hidden>
            GPS na telefonu deluje samo prek HTTPS povezave. Lokalni LAN naslov na http:// ne more zahtevati dovoljenja za lokacijo.
        </div>
        <div id="binProximityToast" class="active-walk-bin-toast" hidden>
            <div>
                <strong>Koš je blizu</strong>
                <span id="binProximityText">Planirani koš je na tvoji poti.</span>
            </div>
            <button type="button" id="dismissBinProximityToast" aria-label="Zapri obvestilo">×</button>
        </div>
        <div id="walkMap"></div>
        <div class="active-walk-map-controls" aria-label="Kontrole zemljevida">
            <button type="button" id="recenterWalkMap">
                <i class="bi bi-crosshair" aria-hidden="true"></i>
                <span>Moja lokacija</span>
            </button>
            <button type="button" id="fitWalkRoute">
                <i class="bi bi-signpost-split-fill" aria-hidden="true"></i>
                <span>Celotna pot</span>
            </button>
            <button type="button" id="openWalkActions"><i class="bi bi-camera" aria-hidden="true"></i><span>Dejanja</span></button>
        </div>
    </article>

    <aside class="active-walk-cockpit" aria-label="Kontrole sprehoda">
        <button type="button" id="walkCockpitToggle" class="active-walk-cockpit__toggle" aria-expanded="false" aria-controls="walkCockpitActions">
            <span class="active-walk-cockpit__grip" aria-hidden="true"></span>
            <span class="active-walk-cockpit__summary">
                <strong>V živo · @Model.Dog?.Name</strong>
                <span><span id="cockpitDuration">00:00</span> · <span id="cockpitDistance">@SlovenianFormatting.WalkDistance(Model.DistanceMeters)</span> · <span id="cockpitGpsHealth">GPS išče signal</span></span>
            </span>
            <i class="bi bi-chevron-up" aria-hidden="true"></i>
        </button>
        <p id="cockpitGpsNotice" class="active-walk-cockpit__notice" role="status" hidden></p>
        <p id="cockpitPhotoStatus" class="active-walk-cockpit__notice" role="status" hidden></p>
        <p id="cockpitFinishStatus" class="active-walk-cockpit__notice" role="status" hidden></p>
        @if (TempData["SuccessMessage"] is string walkSuccess)
        {
            <p class="active-walk-cockpit__notice" role="status">@walkSuccess</p>
        }
        @if (TempData["ErrorMessage"] is string walkError)
        {
            <p class="active-walk-cockpit__notice" role="alert">@walkError</p>
        }
        <div id="walkCockpitActions" class="active-walk-cockpit__actions" hidden>
            <div id="mobileNextStopSlot"></div>
            <div class="active-walk-cockpit__action-grid">
                <form asp-controller="Walks" asp-action="AddPhoto" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data" class="active-walk-cockpit__photo-form">
                    @Html.AntiForgeryToken()
                    <label class="active-walk-cockpit__action"><i class="bi bi-camera" aria-hidden="true"></i> Fotografija
                        <input type="file" name="photo" accept="image/*" required />
                    </label>
                </form>
                <a class="active-walk-cockpit__action" asp-controller="Map" asp-action="Index" asp-route-nearestBin="1"><i class="bi bi-geo-alt" aria-hidden="true"></i> Najdi koš</a>
                <a class="active-walk-cockpit__action" asp-controller="Map" asp-action="Add" asp-route-walkId="@Model.Id"><i class="bi bi-plus-circle" aria-hidden="true"></i> Dodaj koš</a>
            </div>
            <button type="submit" form="finishWalkForm" id="finishWalkMobileButton" class="active-walk-cockpit__finish"><i class="bi bi-stop-circle" aria-hidden="true"></i> Zaključi sprehod</button>
        </div>
    </aside>

    <div class="active-walk-metrics">
        <article>
            <strong id="duration">00:00</strong>
            <span>Trajanje</span>
        </article>
        <article>
            <strong id="distance">@SlovenianFormatting.WalkDistance(Model.DistanceMeters)</strong>
            <span>Razdalja</span>
        </article>
        <article>
            <strong id="pointCount">@((Model.Points?.Count ?? 0).ToString())</strong>
            <span>GPS točke</span>
        </article>
    </div>

    @if (Model.PlannedWalk?.Stops?.Count > 0)
    {
        <article class="active-walk-plan-card">
            <div class="active-walk-plan-card__header">
                <h2>Planirani postanki</h2>
                <span id="plannedStopProgress">@completedStopCount / @plannedStopCount opravljenih</span>
            </div>
            <div class="active-walk-stop-list">
                @foreach (var stop in Model.PlannedWalk.Stops.OrderBy(stop => stop.Order))
                {
                    var isCompleted = completedStopIds.Contains(stop.Id);
                    <label class="@(isCompleted ? "is-completed" : string.Empty)">
                        <input type="checkbox" data-stop-id="@stop.Id" @(isCompleted ? "checked" : null) disabled="@(stop.Type == "start" ? "disabled" : null)" />
                        <span>
                            <strong>@stop.Name</strong>
                            <small>@stop.Label - @stop.Reason</small>
                        </span>
                    </label>
                }
            </div>
        </article>
    }

    <article class="active-walk-media-card">
        <div class="active-walk-media-card__header">
            <div>
                <h2>Fotografije sprehoda</h2>
                <p>Dodaj fotografijo med sprehodom.</p>
            </div>
            <span>@walkPhotos.Count fotografij</span>
        </div>

        <form asp-controller="Walks" asp-action="AddPhoto" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data" class="active-walk-photo-upload" id="activeWalkPhotoUpload">
            @Html.AntiForgeryToken()
            <input type="hidden" name="plannedWalkStopId" id="photoStopId" />
            <label class="active-walk-photo-pick"><i class="bi bi-camera" aria-hidden="true"></i> Dodaj fotografijo
                <input type="file" name="photo" accept="image/*" required />
            </label>
            <details class="active-walk-photo-details"><summary>Dodaj opis</summary>
                <input type="text" name="caption" id="photoCaptionInput" maxlength="120" placeholder="Opis (neobvezno)" />
            </details>
            <button type="submit">Naloži fotografijo</button>
        </form>
        <p class="active-walk-photo-hint" id="photoStopHint">Fotografijo lahko dodaš tudi pri postanku na zemljevidu.</p>

        @if (walkPhotos.Count > 0)
        {
            <div class="active-walk-photo-strip">
                @foreach (var photo in walkPhotos.Take(6))
                {
                    <figure class="active-walk-photo-item">
                        <img src="@photo.ImageUrl" alt="Fotografija sprehoda @Model.Dog?.Name" />
                        @if (!string.IsNullOrWhiteSpace(photo.Caption))
                        {
                            <figcaption>@photo.Caption</figcaption>
                        }
                    </figure>
                }
            </div>
        }
    </article>

    @if (Model.PlannedWalk?.Stops?.Count > 0)
    {
        <article class="active-walk-next-stop-card" id="nextStopCard">
            <div class="active-walk-next-stop-card__header">
                <div>
                    <h2>Naslednji postanek</h2>
                    <p id="nextStopMeta">Naslednji postanek na načrtovani poti.</p>
                </div>
                <span id="nextStopDistance">-</span>
            </div>
            <div class="active-walk-next-stop-card__body">
                <div>
                    <strong id="nextStopName">Vsi postanki so opravljeni.</strong>
                    <small id="nextStopReason">Ko odkljukas naslednji postanek, se tukaj pokaze novi predlog.</small>
                </div>
                <div class="active-walk-next-stop-card__actions">
                    <button type="button" id="showNextStopButton" class="btn btn-outline-success rounded-pill fw-semibold" disabled>Prikaži na zemljevidu</button>
                    <button type="button" id="completeNextStopButton" class="btn btn-success rounded-pill fw-semibold" disabled>Potrdi obisk</button>
                </div>
            </div>
        </article>

        <article class="active-walk-proximity-card" id="proximityCard">
            <div class="active-walk-proximity-card__header">
                <div>
                    <h2>Bližina postanka</h2>
                    <p id="proximityStatus">Ko se približas planiranemu postanku, te DoggyDrop opozori.</p>
                </div>
                <span id="proximityMode">Auto</span>
            </div>
            <div class="active-walk-proximity-card__body">
                <label>
                    <input type="checkbox" id="autoCompleteStopsToggle" checked />
                    <span>Samodejno označi postanek, ko sem dovolj blizu</span>
                </label>
                <label>
                    <input type="checkbox" id="vibrateOnStopToggle" checked />
                    <span>Nežna vibracija pri bližini koša ali postanka</span>
                </label>
            </div>
        </article>
    }

    <form asp-controller="Walks" asp-action="Finish" asp-route-id="@Model.Id" method="post" class="active-walk-finish-card" id="finishWalkForm">
        @Html.AntiForgeryToken()
        <h2>Zaključi sprehod</h2>
        <p>Če GPS trenutno ne deluje, lahko razdaljo vneseš ročno.</p>

        <div class="active-walk-finish-card__grid">
            <div>
                <label for="manualDistanceKm" class="form-label">Razdalja v km</label>
                <input id="manualDistanceKm" name="manualDistanceKm" class="form-control" inputmode="decimal" placeholder="npr. 2.4" />
            </div>
            <div>
                <label for="usedBinsCount" class="form-label">Uporabljeni kosi</label>
                <input id="usedBinsCount" name="usedBinsCount" type="number" min="0" max="50" class="form-control" placeholder="0" />
            </div>
        </div>

        <div class="active-walk-actions">
            <a class="btn btn-outline-secondary rounded-pill" asp-controller="Walks" asp-action="Index">Nazaj</a>
            <button type="submit" id="finishWalkButton" class="btn btn-success rounded-pill fw-semibold">Zaključi sprehod</button>
        </div>
        <p id="gpsRecordingWarning" role="status" hidden></p>
        @if (debugGpsEnabled)
        {
            <aside id="gpsDebugPanel" class="gps-debug-panel" aria-label="GPS diagnostika">
                GPS callbacks: <span id="gpsDebugCallbacks">0</span> ·
                Stale: <span id="gpsDebugStale">0</span> ·
                Deferred: <span id="gpsDebugDeferred">0</span> ·
                Requests: <span id="gpsDebugRequests">0</span> ·
                Success: <span id="gpsDebugSuccess">0</span> ·
                Duplicate: <span id="gpsDebugDuplicate">0</span> ·
                Out-of-order: <span id="gpsDebugOutOfOrder">0</span> ·
                Invalid: <span id="gpsDebugInvalid">0</span> ·
                No longer active: <span id="gpsDebugInactive">0</span> ·
                Failure: <span id="gpsDebugFailure">0</span> ·
                Last response: <span id="gpsDebugResponse">none</span> ·
                Persisted points: <span id="gpsDebugPersisted">@(Model.Points?.Count ?? 0)</span> ·
                Distance: <span id="gpsDebugDistance">@Math.Round(Model.DistanceMeters) m</span> ·
                Watch: <span id="gpsDebugWatch">off</span>
            </aside>
        }
        <p id="finishWalkStatus" role="status" aria-live="polite" hidden></p>
    </form>
</section>

@section Scripts {
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
            integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
            crossorigin=""></script>

    <script>
        const walkId = @Model.Id;
        const startedAt = new Date("@Model.StartedAt.ToString("O")");
        const initialPoints = @pointsJson;
        const plannedRoutePoints = @plannedRoutePointsJson;
        const plannedStops = @plannedStopsJson;
        const completedStopIds = new Set(@completedStopIdsJson);
        const durationElement = document.getElementById("duration");
        const distanceElement = document.getElementById("distance");
        const pointCountElement = document.getElementById("pointCount");
        const gpsStatusElement = document.getElementById("gpsStatus");
        const trackingToggle = document.getElementById("trackingToggle");
        const gpsSecurityWarning = document.getElementById("gpsSecurityWarning");
        const gpsRecordingWarning = document.getElementById("gpsRecordingWarning");
        const cockpitGpsHealth = document.getElementById("cockpitGpsHealth");
        const cockpitGpsNotice = document.getElementById("cockpitGpsNotice");
        const walkCockpitToggle = document.getElementById("walkCockpitToggle");
        const walkCockpitActions = document.getElementById("walkCockpitActions");
        const finishWalkMobileButton = document.getElementById("finishWalkMobileButton");
        const plannedStopProgressElement = document.getElementById("plannedStopProgress");
        const nextStopNameElement = document.getElementById("nextStopName");
        const nextStopReasonElement = document.getElementById("nextStopReason");
        const nextStopMetaElement = document.getElementById("nextStopMeta");
        const nextStopDistanceElement = document.getElementById("nextStopDistance");
        const completeNextStopButton = document.getElementById("completeNextStopButton");
        const photoStopIdInput = document.getElementById("photoStopId");
        const photoCaptionInput = document.getElementById("photoCaptionInput");
        const photoStopHint = document.getElementById("photoStopHint");
        const proximityStatusElement = document.getElementById("proximityStatus");
        const proximityModeElement = document.getElementById("proximityMode");
        const autoCompleteStopsToggle = document.getElementById("autoCompleteStopsToggle");
        const vibrateOnStopToggle = document.getElementById("vibrateOnStopToggle");
        const binProximityToast = document.getElementById("binProximityToast");
        const binProximityText = document.getElementById("binProximityText");
        const dismissBinProximityToast = document.getElementById("dismissBinProximityToast");
        const recenterWalkMapButton = document.getElementById("recenterWalkMap");
        const fitWalkRouteButton = document.getElementById("fitWalkRoute");
        const finishWalkForm = document.getElementById("finishWalkForm");
        const finishWalkButton = document.getElementById("finishWalkButton");
        const finishWalkStatus = document.getElementById("finishWalkStatus");
        const autoCompletePreferenceKey = "doggydrop.walk.autoCompleteStops";
        const vibratePreferenceKey = "doggydrop.walk.vibrateOnStop";
        const autoCompleteRadiusMeters = 28;
        const approachRadiusMeters = 60;
        const binAlertRadiusMeters = 85;

        let map;
        let routeLine;
        let plannedRouteLine;
        let userMarker;
        let plannedStopMarkers = [];
        let checklistCheckboxes = [];
        let routePoints = initialPoints.map(point => [point.latitude, point.longitude]);
        let currentPosition = routePoints.length > 0 ? routePoints[routePoints.length - 1] : null;
        let currentNextStopId = null;
        let watchId = null;
        let watchGeneration = 0;
        let isTracking = false;
        let isSending = false;
        let pendingPosition = null;
        let lastGpsCallbackAt = 0;
        let pageHiddenAt = 0;
        let mapResizeObserver = null;
        let distanceMeters = @Model.DistanceMeters.ToString(System.Globalization.CultureInfo.InvariantCulture);
        let lastApproachStopId = null;
        let lastCompletedByProximityStopId = null;
        let lastBinToastStopId = null;
        let binToastTimeout = null;
        let isFinishing = false;

        document.addEventListener("DOMContentLoaded", function () {
            initTimer();
            initMap();
            setWalkCockpitExpanded(false);
            if (window.ResizeObserver) {
                new ResizeObserver(entries => {
                    const height = entries[0]?.target.getBoundingClientRect().height;
                    if (height) document.querySelector(".active-walk-page").style.setProperty("--walk-cockpit-height", `${Math.ceil(height)}px`);
                }).observe(document.querySelector(".active-walk-cockpit"));
            }
            wireStopChecklist();
            wireProximityControls();
            dismissBinProximityToast?.addEventListener("click", hideBinProximityToast);
            recenterWalkMapButton?.addEventListener("click", recenterWalkMap);
            fitWalkRouteButton?.addEventListener("click", fitWalkRoute);
            updateNextStopCard();
            validateGpsEnvironment();
            trackingToggle.addEventListener("click", toggleTracking);
            walkCockpitToggle.addEventListener("click", () => setWalkCockpitExpanded(walkCockpitToggle.getAttribute("aria-expanded") !== "true"));
            document.getElementById("openWalkActions")?.addEventListener("click", () => setWalkCockpitExpanded(true));
            document.getElementById("showNextStopButton")?.addEventListener("click", () => {
                const stop = plannedStops.find(item => Number(item.id ?? item.Id) === currentNextStopId);
                if (!stop || !map) return;
                const rawLat = stop.latitude ?? stop.Latitude;
                const rawLng = stop.longitude ?? stop.Longitude;
                if (rawLat == null || rawLng == null) return;
                const lat = Number(rawLat);
                const lng = Number(rawLng);
                if (!isValidStopCoordinate(lat, lng)) return;
                setWalkCockpitExpanded(false);
                map.setView([lat, lng], Math.max(map.getZoom(), 16));
            });
            const quickPhotoForm = document.querySelector(".active-walk-cockpit__photo-form");
            const quickPhotoInput = quickPhotoForm?.querySelector('input[type="file"]');
            const quickPhotoStatus = document.getElementById("cockpitPhotoStatus");
            quickPhotoInput?.addEventListener("change", async () => {
                if (!quickPhotoInput.files.length) return;
                quickPhotoInput.disabled = true;
                quickPhotoStatus.hidden = false;
                quickPhotoStatus.textContent = "Shranjujem fotografijo …";
                try {
                    const photo = quickPhotoInput.files[0];
                    const body = new FormData(quickPhotoForm);
                    body.set("photo", photo);
                    const response = await fetch(quickPhotoForm.action, { method: "POST", body, credentials: "same-origin", headers: { "Accept": "application/json" } });
                    if (!response.ok || !(response.headers.get("content-type") || "").includes("application/json")) throw new Error();
                    const result = await response.json();
                    if (!result.message) throw new Error();
                    quickPhotoStatus.textContent = "Fotografija je shranjena. Sprehod se nadaljuje.";
                } catch {
                    quickPhotoStatus.textContent = "Fotografije ni bilo mogoče shraniti. Poskusi znova.";
                } finally {
                    quickPhotoInput.disabled = false;
                    quickPhotoInput.value = "";
                }
            });
            const stopCard = document.getElementById("nextStopCard");
            if (stopCard) {
                const originalParent = stopCard.parentElement;
                const originalNext = stopCard.nextElementSibling;
                const syncStopPlacement = () => {
                    if (window.matchMedia("(max-width: 575.98px)").matches) document.getElementById("mobileNextStopSlot").appendChild(stopCard);
                    else originalParent.insertBefore(stopCard, originalNext);
                };
                syncStopPlacement();
                window.matchMedia("(max-width: 575.98px)").addEventListener("change", syncStopPlacement);
            }
            document.addEventListener("visibilitychange", handleWalkVisibility);
            window.setInterval(checkGpsSilence, 30000);
            finishWalkForm?.addEventListener("submit", finishWalk);
            if (window.isSecureContext && navigator.geolocation) {
                window.setTimeout(startTracking, 400);
            }
            completeNextStopButton?.addEventListener("click", async function () {
                if (currentNextStopId) {
                    await toggleStopState(currentNextStopId, true);
                }
            });
        });

        function validateGpsEnvironment() {
            if (window.isSecureContext) {
                return;
            }

            gpsStatusElement.textContent = "GPS zahteva HTTPS povezavo.";
            setWalkHealth("GPS zapis omejen");
            gpsSecurityWarning.hidden = false;
            if (proximityStatusElement) {
                proximityStatusElement.textContent = "Za živo bližinsko opozarjanje telefon potrebuje GPS dovoljenje.";
            }
        }

        function wireProximityControls() {
            if (!autoCompleteStopsToggle || !vibrateOnStopToggle) {
                return;
            }

            const storedAutoComplete = localStorage.getItem(autoCompletePreferenceKey);
            const storedVibrate = localStorage.getItem(vibratePreferenceKey);

            autoCompleteStopsToggle.checked = storedAutoComplete === null ? true : storedAutoComplete === "true";
            vibrateOnStopToggle.checked = storedVibrate === null ? true : storedVibrate === "true";
            updateProximityModeLabel();

            autoCompleteStopsToggle.addEventListener("change", function () {
                localStorage.setItem(autoCompletePreferenceKey, autoCompleteStopsToggle.checked ? "true" : "false");
                updateProximityModeLabel();
            });

            vibrateOnStopToggle.addEventListener("change", function () {
                localStorage.setItem(vibratePreferenceKey, vibrateOnStopToggle.checked ? "true" : "false");
                updateProximityModeLabel();
            });
        }

        function updateProximityModeLabel() {
            if (!proximityModeElement) {
                return;
            }

            const autoLabel = autoCompleteStopsToggle?.checked ? "Auto" : "Manual";
            const vibrateLabel = vibrateOnStopToggle?.checked ? " + vibracija" : "";
            proximityModeElement.textContent = `${autoLabel}${vibrateLabel}`;
        }

        function initTimer() {
            updateDuration();
            setInterval(updateDuration, 1000);
        }

        function updateDuration() {
            const diffSeconds = Math.max(0, Math.floor((Date.now() - startedAt.getTime()) / 1000));
            const hours = Math.floor(diffSeconds / 3600);
            const minutes = Math.floor((diffSeconds % 3600) / 60);
            const seconds = diffSeconds % 60;

            if (hours > 0) {
                durationElement.textContent = `${String(hours).padStart(2, "0")}:${String(minutes).padStart(2, "0")}:${String(seconds).padStart(2, "0")}`;
            } else {
                durationElement.textContent = `${String(minutes).padStart(2, "0")}:${String(seconds).padStart(2, "0")}`;
            }
            document.getElementById("cockpitDuration").textContent = durationElement.textContent;
        }

        function setWalkCockpitExpanded(expanded) {
            walkCockpitActions.hidden = !expanded;
            walkCockpitToggle.setAttribute("aria-expanded", String(expanded));
            document.querySelector(".active-walk-cockpit").classList.toggle("is-expanded", expanded);
            document.querySelector(".active-walk-page").classList.toggle("cockpit-expanded", expanded);
            requestAnimationFrame(() => {
                const height = document.querySelector(".active-walk-cockpit").getBoundingClientRect().height;
                document.querySelector(".active-walk-page").style.setProperty("--walk-cockpit-height", `${Math.ceil(height)}px`);
                map?.invalidateSize({ pan: false });
            });
        }

        function setWalkHealth(message) { cockpitGpsHealth.textContent = message; }

        function showWalkNotice(message) {
            cockpitGpsNotice.hidden = !message;
            cockpitGpsNotice.textContent = message || "";
        }

        function initMap() {
            const plannedPoints = plannedRoutePoints.map(point => [point.latitude, point.longitude]);
            const fallback = routePoints.length > 0
                ? routePoints[routePoints.length - 1]
                : plannedPoints.length > 0
                    ? plannedPoints[0]
                    : [46.5547, 15.6459];
            map = L.map("walkMap", {
                preferCanvas: true,
                zoomControl: true
            }).setView(fallback, routePoints.length > 0 ? 17 : 14);

            L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
                maxZoom: 19,
                attribution: "&copy; OpenStreetMap"
            }).addTo(map);

            if (plannedPoints.length > 1) {
                plannedRouteLine = L.polyline(plannedPoints, {
                    color: "#e18d32",
                    weight: 5,
                    opacity: 0.62,
                    dashArray: "10 10"
                }).addTo(map);
            }

            plannedStops.forEach(stop => {
                const rawLat = stop.latitude ?? stop.Latitude;
                const rawLng = stop.longitude ?? stop.Longitude;
                if (rawLat == null || rawLng == null) return;
                const lat = Number(rawLat);
                const lng = Number(rawLng);
                if (!isValidStopCoordinate(lat, lng)) return;
                const stopId = Number(stop.id ?? stop.Id);
                const marker = L.marker([lat, lng], { icon: createPlannedStopIcon(stop.type ?? stop.Type, stopId) })
                    .addTo(map)
                    .bindPopup(buildStopPopup(stop));
                marker.stopId = stopId;
                marker.on("popupopen", function () {
                    wirePopupAction(stopId);
                });
                plannedStopMarkers.push(marker);
            });

            routeLine = L.polyline(routePoints, { color: "#2f6d5f", weight: 6, opacity: 0.9 }).addTo(map);

            if (routePoints.length > 0) {
                userMarker = L.marker(routePoints[routePoints.length - 1], { icon: createCurrentLocationIcon() }).addTo(map);
                map.fitBounds(routeLine.getBounds().pad(0.2), { maxZoom: 17 });
            } else if (plannedRouteLine) {
                map.fitBounds(plannedRouteLine.getBounds().pad(0.2), { maxZoom: 16 });
            }

            scheduleMapRefresh();
        }

        function isValidStopCoordinate(lat, lng) {
            return Number.isFinite(lat) && Number.isFinite(lng)
                && lat >= -90 && lat <= 90 && lng >= -180 && lng <= 180;
        }

        function createPlannedStopIcon(type) {
            const labels = {
                start: "S",
                finish: "C",
                bin: "B",
                park: "P",
                water: "W",
                cafe: "C",
                shop: "T"
            };

            return L.divIcon({
                className: "",
                html: `<span class="active-planned-marker active-planned-marker--${escapeHtml(type || "stop")}">${labels[type] || "*"}</span>`,
                iconSize: [34, 34],
                iconAnchor: [17, 17],
                popupAnchor: [0, -16]
            });
        }

        function createCurrentLocationIcon() {
            return L.divIcon({
                className: "",
                html: '<span class="active-user-marker"><span></span></span>',
                iconSize: [34, 34],
                iconAnchor: [17, 17]
            });
        }

        function scheduleMapRefresh() {
            const mapElement = document.getElementById("walkMap");
            const refreshMapSize = function () {
                if (!map) {
                    return;
                }

                map.invalidateSize({ pan: false });
                if (currentPosition) {
                    map.setView(currentPosition, Math.max(map.getZoom(), 17), { animate: false });
                }
            };

            requestAnimationFrame(refreshMapSize);
            window.setTimeout(refreshMapSize, 200);
            window.setTimeout(refreshMapSize, 700);
            window.addEventListener("load", refreshMapSize, { once: true });
            window.addEventListener("resize", refreshMapSize);

            if (mapElement && "ResizeObserver" in window && !mapResizeObserver) {
                mapResizeObserver = new ResizeObserver(refreshMapSize);
                mapResizeObserver.observe(mapElement);
            }
        }

        function recenterWalkMap() {
            if (!map || !currentPosition) {
                return;
            }

            map.invalidateSize({ pan: false });
            map.setView(currentPosition, Math.max(map.getZoom(), 17), { animate: true });
        }

        function fitWalkRoute() {
            if (!map) {
                return;
            }

            const bounds = L.latLngBounds([]);
            routePoints.forEach(point => bounds.extend(point));
            plannedRoutePoints.forEach(point => bounds.extend([point.latitude, point.longitude]));

            if (!bounds.isValid()) {
                recenterWalkMap();
                return;
            }

            map.invalidateSize({ pan: false });
            map.fitBounds(bounds.pad(0.22), { maxZoom: 17, padding: [36, 36], animate: true });
        }

        function toggleTracking() {
            if (isTracking) {
                stopTracking();
            } else {
                startTracking();
            }
        }

        function startTracking() {
            if (isFinishing || isTracking) return;
            if (!window.isSecureContext) {
                gpsStatusElement.textContent = "Brskalnik ne dovoli GPS-a na tej povezavi.";
                gpsSecurityWarning.hidden = false;
                return;
            }

            if (!navigator.geolocation) {
                gpsStatusElement.textContent = "Ta brskalnik ne podpira GPS sledenja.";
                return;
            }

            isTracking = true;
            startGpsWatch();
            document.querySelector(".active-walk-page")?.classList.add("is-tracking");
            trackingToggle.textContent = "Pavziraj GPS";
            trackingToggle.classList.remove("btn-success");
            trackingToggle.classList.add("btn-warning");
            gpsStatusElement.textContent = "GPS zapis teče.";
            setWalkHealth("GPS išče signal");
        }

        function startGpsWatch() {
            const options = { enableHighAccuracy: true, maximumAge: 0, timeout: 12000 };
            const generation = ++watchGeneration;
            pendingPosition = null;
            if (watchId !== null) navigator.geolocation.clearWatch(watchId);
            watchId = navigator.geolocation.watchPosition(
                position => handlePosition(position, false, generation),
                error => { if (generation === watchGeneration) handleGpsError(error); }, options);
            navigator.geolocation.getCurrentPosition(
                position => handlePosition(position, false, generation),
                error => { if (generation === watchGeneration) handleGpsError(error); }, options);
            setGpsDebug("Watch", "on");
        }

        function handleWalkVisibility() {
            if (document.hidden) {
                pageHiddenAt = Date.now();
                return;
            }
            if (!isTracking || isFinishing) return;
            if (pageHiddenAt && Date.now() - pageHiddenAt > 30000) {
                gpsRecordingWarning.hidden = false;
                gpsRecordingWarning.textContent = "Aplikacija je bila v ozadju. V tem času GPS pot morda ni bila zabeležena.";
                showWalkNotice("Aplikacija je bila v ozadju. Del poti morda ni zabeležen.");
            }
            startGpsWatch();
            pageHiddenAt = 0;
        }

        function checkGpsSilence() {
            if (!isTracking || document.hidden || !lastGpsCallbackAt) return;
            if (Date.now() - lastGpsCallbackAt > 90000) {
                gpsRecordingWarning.hidden = false;
                gpsRecordingWarning.textContent = "Že več kot minuto ni novih GPS točk. Preveri dovoljenje za lokacijo in odprtost aplikacije.";
                showWalkNotice("GPS že nekaj časa ne beleži poti.");
            }
        }

        function setGpsDebug(field, value) {
            const element = document.getElementById(`gpsDebug${field}`);
            if (element) element.textContent = String(value);
        }

        function incrementGpsDebug(field) {
            const element = document.getElementById(`gpsDebug${field}`);
            if (element) element.textContent = String(Number(element.textContent) + 1);
        }

        function stopTracking() {
            ++watchGeneration;
            if (watchId !== null) {
                navigator.geolocation.clearWatch(watchId);
                watchId = null;
            }

            isTracking = false;
            pendingPosition = null;
            setGpsDebug("Watch", "off");
            document.querySelector(".active-walk-page")?.classList.remove("is-tracking");
            trackingToggle.textContent = "Nadaljuj GPS";
            trackingToggle.classList.remove("btn-warning");
            trackingToggle.classList.add("btn-success");
            gpsStatusElement.textContent = "GPS sledenje je pavzirano.";
            setWalkHealth("GPS pavziran");
        }

        async function handlePosition(position, fromQueue = false, generation = watchGeneration) {
            if (generation !== watchGeneration) {
                incrementGpsDebug("Stale");
                return;
            }
            if (!fromQueue) {
                incrementGpsDebug("Callbacks");
                lastGpsCallbackAt = Date.now();
            }
            if (isFinishing || !isTracking) {
                return;
            }

            if (isSending) {
                pendingPosition = { position, generation };
                incrementGpsDebug("Deferred");
                return;
            }

            const lat = position.coords.latitude;
            const lng = position.coords.longitude;
            const accuracy = Math.round(position.coords.accuracy);

            isSending = true;
            incrementGpsDebug("Requests");

            try {
                const response = await fetch(`/Walks/AddPoint/${walkId}`, {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json"
                    },
                    credentials: "same-origin",
                    body: JSON.stringify({
                        latitude: lat,
                        longitude: lng,
                        accuracyMeters: position.coords.accuracy,
                        recordedAt: new Date(position.timestamp).toISOString()
                    })
                });

                if (!response.ok) {
                    incrementGpsDebug("Failure");
                    setGpsDebug("Response", `HTTP ${response.status}`);
                    if (isFinishing || generation !== watchGeneration) return;
                    if (response.status === 409) {
                        incrementGpsDebug("Inactive");
                        const state = await response.json().catch(() => ({}));
                        stopTracking();
                        window.location.assign(`/Walks/${state.status === "Completed" ? "Details" : "Interrupted"}/${walkId}`);
                        return;
                    }
                    if (response.status === 400) incrementGpsDebug("Invalid");
                    gpsStatusElement.textContent = "GPS točka ni bila shranjena.";
                    showWalkNotice("GPS točka ni bila shranjena. Preveri povezavo.");
                    return;
                }

                const data = await response.json();
                if (isFinishing || generation !== watchGeneration) return;
                if (data.outcome !== "accepted") {
                    if (data.outcome === "duplicate") incrementGpsDebug("Duplicate");
                    if (data.outcome === "out-of-order") incrementGpsDebug("OutOfOrder");
                    setGpsDebug("Response", data.outcome);
                    setGpsDebug("Persisted", data.pointCount);
                    setGpsDebug("Distance", `${Math.round(data.distanceMeters)} m`);
                    return;
                }
                incrementGpsDebug("Success");
                setGpsDebug("Response", "accepted");
                setGpsDebug("Persisted", data.pointCount);
                setGpsDebug("Distance", `${Math.round(data.distanceMeters)} m`);
                gpsRecordingWarning.hidden = true;
                showWalkNotice("");
                setWalkHealth(accuracy <= 50 ? "GPS dober" : "GPS išče signal");
                distanceMeters = data.distanceMeters;
                routePoints.push([lat, lng]);
                pointCountElement.textContent = data.pointCount;
                distanceElement.textContent = `${(distanceMeters / 1000).toLocaleString("sl-SI", { minimumFractionDigits: 2, maximumFractionDigits: 2 })} km`;
                document.getElementById("cockpitDistance").textContent = distanceElement.textContent;
                gpsStatusElement.textContent = `Zadnja tocnost: ${accuracy} m`;
                updateRoute(lat, lng);
            } catch {
                incrementGpsDebug("Failure");
                setGpsDebug("Response", "network error");
                if (!isFinishing) gpsStatusElement.textContent = "GPS točka ni bila shranjena. Preveri povezavo.";
                if (!isFinishing) showWalkNotice("GPS točka ni bila shranjena. Preveri povezavo.");
            } finally {
                isSending = false;
                const next = pendingPosition;
                pendingPosition = null;
                if (next && isTracking && !isFinishing) void handlePosition(next.position, true, next.generation);
            }
        }

        async function finishWalk(event) {
            event.preventDefault();
            if (isFinishing) return;
            if (!window.confirm("Zaključim sprehod?")) return;
            const wasTracking = isTracking;
            isFinishing = true;
            stopTracking();
            finishWalkButton.disabled = true;
            finishWalkButton.textContent = "Zaključujem …";
            finishWalkMobileButton.disabled = true;
            finishWalkMobileButton.textContent = "Zaključujem …";
            finishWalkStatus.hidden = false;
            finishWalkStatus.textContent = "Zaključujem sprehod …";
            document.getElementById("cockpitFinishStatus").hidden = false;
            document.getElementById("cockpitFinishStatus").textContent = finishWalkStatus.textContent;

            const controller = new AbortController();
            const timeoutId = window.setTimeout(() => controller.abort(), 30000);
            try {
                const response = await fetch(finishWalkForm.action, {
                    method: "POST",
                    body: new FormData(finishWalkForm),
                    credentials: "same-origin",
                    headers: { "Accept": "application/json" },
                    signal: controller.signal
                });
                if (!response.ok) {
                    throw new Error("Zaključek ni uspel. Preveri povezavo in poskusi znova.");
                }
                const result = await response.json();
                const destination = new URL(result.redirectUrl, window.location.origin);
                if (destination.origin !== window.location.origin || !/^\/Walks\/(Details|Interrupted)(\/|$)/i.test(destination.pathname)) {
                    throw new Error("Ciljna stran sprehoda ni na voljo. Osveži stran in preveri stanje.");
                }
                window.location.assign(destination.href);
            } catch (error) {
                isFinishing = false;
                finishWalkButton.disabled = false;
                finishWalkButton.textContent = "Zaključi sprehod";
                finishWalkMobileButton.disabled = false;
                finishWalkMobileButton.textContent = "Zaključi sprehod";
                finishWalkStatus.textContent = error.message || "Zaključek ni uspel. Poskusi znova.";
                document.getElementById("cockpitFinishStatus").textContent = finishWalkStatus.textContent;
                if (wasTracking) startTracking();
            } finally {
                window.clearTimeout(timeoutId);
            }
        }

        function updateRoute(lat, lng) {
            routeLine.setLatLngs(routePoints);

            if (userMarker) {
                userMarker.setLatLng([lat, lng]);
            } else {
                userMarker = L.marker([lat, lng], { icon: createCurrentLocationIcon() }).addTo(map);
            }

            currentPosition = [lat, lng];
            updateNextStopCard();
            evaluateStopProximity();
            map.invalidateSize({ pan: false });
            map.setView([lat, lng], Math.max(map.getZoom(), 17));
        }

        function handleGpsError(error) {
            setGpsDebug("Response", `GPS error ${error.code ?? "unknown"}`);
            gpsStatusElement.textContent = error.message || "GPS lokacije ni bilo mogoče pridobiti.";
            showWalkNotice("GPS lokacija ni na voljo. Preveri dovoljenje za lokacijo.");
        }

        function wireStopChecklist() {
            checklistCheckboxes = Array.from(document.querySelectorAll(".active-walk-stop-list input[type='checkbox'][data-stop-id]"));
            if (checklistCheckboxes.length === 0) {
                return;
            }

            updateStopProgress(checklistCheckboxes.length);
            syncStopMarkers();

            checklistCheckboxes.forEach(checkbox => {
                checkbox.addEventListener("change", async function () {
                    const stopId = Number(checkbox.dataset.stopId);
                    const shouldComplete = checkbox.checked;
                    await toggleStopState(stopId, shouldComplete);
                });
            });
        }

        async function toggleStopState(stopId, shouldComplete) {
            const checkbox = checklistCheckboxes.find(item => Number(item.dataset.stopId) === stopId);
            const label = checkbox?.closest("label");

            if (checkbox) {
                checkbox.disabled = true;
            }

            try {
                const response = await fetch(`/Walks/ToggleStop?id=${walkId}&stopId=${stopId}`, {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json"
                    },
                    credentials: "same-origin",
                    body: JSON.stringify({ completed: shouldComplete })
                });

                if (!response.ok) {
                    throw new Error("Toggle failed");
                }

                const data = await response.json();

                if (data.completed) {
                    completedStopIds.add(stopId);
                } else {
                    completedStopIds.delete(stopId);
                }

                if (checkbox) {
                    checkbox.checked = !!data.completed;
                }

                if (label) {
                    label.classList.toggle("is-completed", !!data.completed);
                }

                updateStopProgress(data.totalCount || checklistCheckboxes.length, data.completedCount);
                syncStopMarkers();
                updateNextStopCard();
                return data;
            } catch {
                if (checkbox) {
                    checkbox.checked = !shouldComplete;
                }

                return null;
            } finally {
                if (checkbox) {
                    checkbox.disabled = false;
                }
            }
        }

        function updateStopProgress(totalCount, completedCount) {
            if (!plannedStopProgressElement) {
                return;
            }

            const completed = typeof completedCount === "number" ? completedCount : completedStopIds.size;
            plannedStopProgressElement.textContent = `${completed} / ${totalCount} opravljenih`;
        }

        function buildStopPopup(stop) {
            const stopId = Number(stop.id ?? stop.Id);
            const isCompleted = completedStopIds.has(stopId);
            const actionLabel = isCompleted ? "Oznaci kot neopravljeno" : "Oznaci kot opravljeno";
            const isStart = (stop.type ?? stop.Type) === "start";
            return `
                <div class="active-stop-popup">
                    <strong>${escapeHtml(stop.name ?? stop.Name)}</strong>
                    <small>${escapeHtml(stop.label ?? stop.Label)}</small>
                    <p>${escapeHtml(stop.reason ?? stop.Reason)}</p>
                    ${isStart ? "" : `<button type="button" class="active-stop-popup__button" data-popup-stop-id="${stopId}" data-next-state="${(!isCompleted).toString()}">${actionLabel}</button>`}
                    <button type="button" class="active-stop-popup__button active-stop-popup__button--secondary" data-photo-stop-id="${stopId}" data-photo-stop-name="${escapeHtml(stop.name ?? stop.Name)}">Dodaj foto sem</button>
                </div>
            `;
        }

        function wirePopupAction(stopId) {
            const button = document.querySelector(`.active-stop-popup__button[data-popup-stop-id="${stopId}"]`);
            if (!button || button.dataset.bound === "true") {
                return;
            }

            button.dataset.bound = "true";
            button.addEventListener("click", async function () {
                const nextState = button.dataset.nextState === "true";
                const result = await toggleStopState(stopId, nextState);
                if (result) {
                    const marker = plannedStopMarkers.find(item => item.stopId === stopId);
                    const stop = plannedStops.find(item => Number(item.id ?? item.Id) === stopId);
                    if (marker && stop) {
                        marker.setPopupContent(buildStopPopup(stop));
                        wirePopupAction(stopId);
                    }
                }
            });

            const photoButton = document.querySelector(`.active-stop-popup__button[data-photo-stop-id="${stopId}"]`);
            if (photoButton && photoButton.dataset.bound !== "true") {
                photoButton.dataset.bound = "true";
                photoButton.addEventListener("click", function () {
                    const stopName = photoButton.dataset.photoStopName || "postanek";
                    if (photoStopIdInput) {
                        photoStopIdInput.value = String(stopId);
                    }

                    if (photoCaptionInput && !photoCaptionInput.value) {
                        photoCaptionInput.value = `Foto pri postanku ${stopName}`;
                    }

                    if (photoStopHint) {
                        photoStopHint.textContent = `Fotografija bo povezana s postankom: ${stopName}.`;
                    }

                    photoCaptionInput?.closest("details")?.setAttribute("open", "");
                    photoCaptionInput?.focus();
                    map.closePopup();
                });
            }
        }

        function syncStopMarkers() {
            plannedStopMarkers.forEach(marker => {
                const iconElement = marker.getElement()?.querySelector(".active-planned-marker");
                const isCompleted = completedStopIds.has(marker.stopId);
                if (iconElement) {
                    iconElement.classList.toggle("is-completed", isCompleted);
                }
            });
        }

        function getUpcomingStops() {
            const remaining = plannedStops.filter(stop =>
                (stop.type ?? stop.Type) !== "start" && !completedStopIds.has(Number(stop.id ?? stop.Id)));
            return remaining.filter(stop => (stop.type ?? stop.Type) !== "finish");
        }

        function updateNextStopCard() {
            if (!nextStopNameElement || !nextStopReasonElement || !nextStopMetaElement || !nextStopDistanceElement || !completeNextStopButton) {
                return;
            }

            const remainingStops = getUpcomingStops();
            document.getElementById("nextStopCard").hidden = remainingStops.length === 0;
            if (remainingStops.length === 0) {
                currentNextStopId = null;
                nextStopNameElement.textContent = "Vsi postanki so opravljeni.";
                nextStopReasonElement.textContent = "Planirana pot je v celoti pokrita.";
                nextStopMetaElement.textContent = "Odlično. Lahko nadaljuješ ali zaključiš sprehod.";
                nextStopDistanceElement.textContent = "Končano";
                completeNextStopButton.disabled = true;
                document.getElementById("showNextStopButton").disabled = true;
                return;
            }

            const nextStop = remainingStops[0];
            let distanceToStopMeters = null;

            if (currentPosition) {
                distanceToStopMeters = getDistanceMeters(currentPosition[0], currentPosition[1], nextStop.latitude ?? nextStop.Latitude, nextStop.longitude ?? nextStop.Longitude);
            }

            currentNextStopId = Number(nextStop.id ?? nextStop.Id);
            nextStopNameElement.textContent = nextStop.name ?? nextStop.Name;
            nextStopReasonElement.textContent = `${nextStop.label ?? nextStop.Label} - ${nextStop.reason ?? nextStop.Reason}`;
            nextStopMetaElement.textContent = currentPosition
                ? "Naslednji postanek na načrtovani poti."
                : "GPS se še ni zagnal, zato je prikazan naslednji postanek iz plana.";
            nextStopDistanceElement.textContent = distanceToStopMeters == null ? "Plan" : formatDistance(distanceToStopMeters);
            completeNextStopButton.disabled = false;
            document.getElementById("showNextStopButton").disabled = false;
            completeNextStopButton.textContent = "Potrdi obisk";
        }

        async function evaluateStopProximity() {
            if (!currentPosition || !proximityStatusElement) {
                return;
            }

            const remainingStops = getUpcomingStops()
                .map(stop => ({
                    stop,
                    stopId: Number(stop.id ?? stop.Id),
                    type: (stop.type ?? stop.Type ?? "").toLowerCase(),
                    distance: getDistanceMeters(
                        currentPosition[0],
                        currentPosition[1],
                        stop.latitude ?? stop.Latitude,
                        stop.longitude ?? stop.Longitude)
                }))
                .sort((a, b) => a.distance - b.distance);

            if (remainingStops.length === 0) {
                proximityStatusElement.textContent = "Vsi planirani postanki so že označeni.";
                return;
            }

            const nearest = remainingStops[0];
            const nearestName = nearest.stop.name ?? nearest.stop.Name;
            const nearestBin = remainingStops.find(item => item.type === "bin");

            if (nearestBin && nearestBin.distance <= binAlertRadiusMeters && lastBinToastStopId !== nearestBin.stopId) {
                lastBinToastStopId = nearestBin.stopId;
                showBinProximityToast(nearestBin.stop, nearestBin.distance);
            } else if (nearestBin && nearestBin.distance > binAlertRadiusMeters * 1.6 && lastBinToastStopId === nearestBin.stopId) {
                lastBinToastStopId = null;
            }

            if (nearest.distance <= approachRadiusMeters && lastApproachStopId !== nearest.stopId) {
                lastApproachStopId = nearest.stopId;
                proximityStatusElement.textContent = `Blizu si postanka ${nearestName} (${formatDistance(nearest.distance)}).`;
                if (vibrateOnStopToggle?.checked && navigator.vibrate) {
                    navigator.vibrate([120, 80, 120]);
                }
            } else if (nearest.distance > approachRadiusMeters && lastApproachStopId === nearest.stopId) {
                lastApproachStopId = null;
                proximityStatusElement.textContent = `Naslednji postanek: ${nearestName} (${formatDistance(nearest.distance)}).`;
            } else if (nearest.distance > approachRadiusMeters) {
                proximityStatusElement.textContent = `Naslednji postanek: ${nearestName} (${formatDistance(nearest.distance)}).`;
            }

            const isAutoCompletable = nearest.type === "bin" || nearest.type === "park" || nearest.type === "water" || nearest.type === "cafe";
            if (autoCompleteStopsToggle?.checked &&
                isAutoCompletable &&
                nearest.distance <= autoCompleteRadiusMeters &&
                lastCompletedByProximityStopId !== nearest.stopId) {
                lastCompletedByProximityStopId = nearest.stopId;
                const result = await toggleStopState(nearest.stopId, true);
                if (result) {
                    proximityStatusElement.textContent = `Postanek ${nearestName} je samodejno označen.`;
                    if (vibrateOnStopToggle?.checked && navigator.vibrate) {
                        navigator.vibrate([160, 60, 160, 60, 160]);
                    }
                }
            } else if (nearest.distance > autoCompleteRadiusMeters && lastCompletedByProximityStopId === nearest.stopId) {
                lastCompletedByProximityStopId = null;
            }
        }

        function showBinProximityToast(stop, distance) {
            if (!binProximityToast || !binProximityText) {
                return;
            }

            const stopName = stop.name ?? stop.Name ?? "Koš";
            binProximityText.textContent = `${stopName} je približno ${formatDistance(distance)} stran. Če ga potrebuješ, je zdaj pravi trenutek.`;
            binProximityToast.hidden = false;
            binProximityToast.classList.add("is-visible");

            if (vibrateOnStopToggle?.checked && navigator.vibrate) {
                navigator.vibrate([90, 60, 90]);
            }

            if (binToastTimeout) {
                window.clearTimeout(binToastTimeout);
            }

            binToastTimeout = window.setTimeout(hideBinProximityToast, 8500);
        }

        function hideBinProximityToast() {
            if (!binProximityToast) {
                return;
            }

            binProximityToast.classList.remove("is-visible");
            binProximityToast.hidden = true;
        }

        function formatDistance(distanceMetersValue) {
            if (distanceMetersValue < 1000) {
                return `${Math.round(distanceMetersValue)} m`;
            }

            return `${(distanceMetersValue / 1000).toFixed(2)} km`;
        }

        function getDistanceMeters(lat1, lng1, lat2, lng2) {
            const earthRadius = 6371000;
            const dLat = toRadians(lat2 - lat1);
            const dLng = toRadians(lng2 - lng1);
            const a =
                Math.sin(dLat / 2) * Math.sin(dLat / 2) +
                Math.cos(toRadians(lat1)) * Math.cos(toRadians(lat2)) *
                Math.sin(dLng / 2) * Math.sin(dLng / 2);
            const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
            return earthRadius * c;
        }

        function toRadians(value) {
            return value * (Math.PI / 180);
        }

        function escapeHtml(value) {
            return String(value ?? "")
                .replaceAll("&", "&amp;")
                .replaceAll("<", "&lt;")
                .replaceAll(">", "&gt;")
                .replaceAll('"', "&quot;")
                .replaceAll("'", "&#039;");
        }
    </script>
}

