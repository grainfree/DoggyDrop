@page
@model DoggyDrop.Areas.Identity.Pages.Account.Manage.SetPasswordModel
@{
    Layout = "/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Nastavi geslo";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}
@section Styles { <link rel="stylesheet" href="~/css/account-security.css" asp-append-version="true" /> }
<section class="app-page account-security" aria-labelledby="password-title">
    <header><p class="account-security__eyebrow">Varnost računa</p><h1 id="password-title">Nastavi geslo</h1>
        <p>Ta račun še nima lokalnega gesla. Nastaviš ga lahko za prijavo z e-pošto in geslom. Obstoječa zunanja prijava ostane na voljo.</p></header>
    <form method="post" class="account-security__form">
        <div asp-validation-summary="All" class="account-security__errors" role="alert"></div>
        <div><label asp-for="Input.NewPassword"></label>
            <input asp-for="Input.NewPassword" autocomplete="new-password" aria-describedby="new-error" required />
            <span asp-validation-for="Input.NewPassword" id="new-error"></span></div>
        <div><label asp-for="Input.ConfirmPassword"></label>
            <input asp-for="Input.ConfirmPassword" autocomplete="new-password" aria-describedby="confirm-error" required />
            <span asp-validation-for="Input.ConfirmPassword" id="confirm-error"></span></div>
        <button class="account-security__submit" type="submit">Nastavi geslo</button>
    </form>
    <a class="account-security__back" asp-area="" asp-controller="Home" asp-action="UserProfile">Nazaj na profil</a>
</section>
